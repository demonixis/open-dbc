// Studio identity follows the CMake project version.
#include <windows.h>

LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL

1 ICON "@OPENDBC_STUDIO_ICON@"

1 VERSIONINFO
FILEVERSION @OPENDBC_WINDOWS_VERSION_COMMAS@
PRODUCTVERSION @OPENDBC_WINDOWS_VERSION_COMMAS@
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "OpenDBC Studio"
            VALUE "FileVersion", "@OPENDBC_VERSION@"
            VALUE "InternalName", "opendbc"
            VALUE "OriginalFilename", "opendbc.exe"
            VALUE "ProductName", "OpenDBC"
            VALUE "ProductVersion", "@OPENDBC_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
