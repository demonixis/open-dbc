# Hashes the runtime sources listed by runtime_fingerprint.cmake and writes the runtime manifest and the
# header the interpreter compiles the fingerprint from. Unchanged outputs keep their timestamps.
foreach(OPENDBC_REQUIRED IN ITEMS OPENDBC_SOURCE_DIR OPENDBC_RUNTIME_INPUT_LIST OPENDBC_VERSION OPENDBC_REVISION
                                  OPENDBC_RUNTIME_MANIFEST OPENDBC_RUNTIME_FINGERPRINT_HEADER)
    if(NOT DEFINED ${OPENDBC_REQUIRED})
        message(FATAL_ERROR "${OPENDBC_REQUIRED} is missing")
    endif()
endforeach()

file(STRINGS "${OPENDBC_RUNTIME_INPUT_LIST}" OPENDBC_RUNTIME_INPUTS)
set(OPENDBC_RUNTIME_FINGERPRINT_MATERIAL "OpenDBC-runtime-v1\n")
foreach(OPENDBC_RUNTIME_INPUT IN LISTS OPENDBC_RUNTIME_INPUTS)
    file(SHA256 "${OPENDBC_SOURCE_DIR}/${OPENDBC_RUNTIME_INPUT}" OPENDBC_RUNTIME_INPUT_HASH)
    string(APPEND OPENDBC_RUNTIME_FINGERPRINT_MATERIAL "${OPENDBC_RUNTIME_INPUT}:${OPENDBC_RUNTIME_INPUT_HASH}\n")
endforeach()
string(SHA256 OPENDBC_RUNTIME_FINGERPRINT "${OPENDBC_RUNTIME_FINGERPRINT_MATERIAL}")

configure_file("${CMAKE_CURRENT_LIST_DIR}/opendbc-runtime.json.in" "${OPENDBC_RUNTIME_MANIFEST}" @ONLY)
file(CONFIGURE OUTPUT "${OPENDBC_RUNTIME_FINGERPRINT_HEADER}"
     CONTENT "#pragma once\n\n#define OPENDBC_RUNTIME_FINGERPRINT \"@OPENDBC_RUNTIME_FINGERPRINT@\"\n" @ONLY)
