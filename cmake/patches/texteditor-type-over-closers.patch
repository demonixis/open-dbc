+//
+//	TextEditor::isInsideQuotes
+//
+
+bool TextEditor::isInsideQuotes(DocPos location, ImWchar quote) const {
+	// quotes alternate on a line, so an odd number of them comes before anything they enclose
+	auto& line = document[location.line];
+	auto isQuote = [quote](const Glyph& glyph) { return glyph.codepoint == quote; };
+	return std::count_if(line.begin(), line.begin() + location.index, isQuote) % 2 == 1;
+}
+
+
+//
+//	TextEditor::typingStepsOverCloser
+//
+
+bool TextEditor::typingStepsOverCloser(ImWchar character) {
+	auto location = cursors.getCurrent().getSelectionEnd();
+
+	if (!CodePoint::isPairCloser(character) || location == document.getEndOfLine(location) || document.getCodePoint(location) != character) {
+		return false;
+	}
+
+	auto opener = CodePoint::toPairOpener(character);
+
+	if (opener == character) {
+		return isInsideQuotes(location, character);
+	}
+
+	// another bracket would be one too many when the line has no opener left for it, strings aside
+	auto balance = 0;
+	auto inString = false;
+
+	for (const auto& glyph : document[location.line]) {
+		if (glyph.codepoint == CodePoint::doubleQuote) {
+			inString = !inString;
+
+		} else if (!inString) {
+			balance += (glyph.codepoint == opener) - (glyph.codepoint == character);
+		}
+	}
+
+	return balance <= 0;
+}
