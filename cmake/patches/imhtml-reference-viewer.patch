+struct Document::State {
+  BrowserContainer container{0.0f};
+  litehtml::document::ptr doc;
+  int width = 0;
+  int height = 0;
+  bool hovered = false;
+  bool pressed = false;
+};
+
+Document::Document(const char* html, const Config& config) : state_(std::make_unique<State>()) {
+  state_->container.set_config(config);
+  state_->doc = litehtml::document::createFromString(html, &state_->container);
+}
+
+Document::~Document() = default;
+
+void Document::Layout(ImVec2 viewport) {
+  const int width = std::max(1, (int)viewport.x);
+  const int height = std::max(1, (int)viewport.y);
+  if (state_->width == width && state_->height == height) {
+    return;
+  }
+
+  state_->container.set_viewport(width, height);
+  state_->doc->media_changed();
+  state_->doc->render(width);
+  state_->width = width;
+  state_->height = height;
+}
+
+std::optional<float> Document::AnchorY(const char* id) const {
+  const auto root = state_->doc->root();
+  if (root) {
+    const auto anchor = root->select_one(std::string("[id=\"") + id + "\"]");
+    if (anchor) {
+      return anchor->get_placement().y;
+    }
+  }
+  return std::nullopt;
+}
+
+std::string Document::Draw() {
+  const ImVec2 origin = ImGui::GetCursorScreenPos();
+  auto* draw_list = ImGui::GetWindowDrawList();
+  const ImVec2 top = draw_list->GetClipRectMin();
+  const ImVec2 bottom = draw_list->GetClipRectMax();
+  const auto x = (litehtml::pixel_t)std::floor(top.x - origin.x);
+  const auto y = (litehtml::pixel_t)std::floor(top.y - origin.y);
+  const litehtml::position clip(x, y, std::ceil(bottom.x - origin.x) - x, std::ceil(bottom.y - origin.y) - y);
+  const ImVec2 mouse = ImGui::GetMousePos() - origin;
+  litehtml::position::vector redraw;
+
+  const bool hovered = ImGui::IsWindowHovered() && ImGui::IsMouseHoveringRect(top, bottom);
+  if (hovered) {
+    state_->doc->on_mouse_over(mouse.x, mouse.y, mouse.x, mouse.y, redraw);
+    if (ImGui::IsMouseClicked(ImGuiMouseButton_Left)) {
+      state_->doc->on_lbutton_down(mouse.x, mouse.y, mouse.x, mouse.y, redraw);
+      state_->pressed = true;
+    }
+  } else if (state_->hovered) {
+    state_->doc->on_mouse_leave(redraw);
+  }
+
+  if (state_->pressed && ImGui::IsMouseReleased(ImGuiMouseButton_Left)) {
+    if (hovered) {
+      state_->doc->on_lbutton_up(mouse.x, mouse.y, mouse.x, mouse.y, redraw);
+    } else {
+      state_->doc->on_button_cancel(redraw);
+    }
+    state_->pressed = false;
+  }
+
+  state_->hovered = hovered;
+  state_->container.reset();
+  state_->doc->draw(0, 0, 0, &clip);
+  ImGui::Dummy(ImVec2(state_->doc->width(), state_->doc->height()));
+  return state_->container.pop_load_url();
+}
 };  // namespace ImHTML
