foreach(OPENDBC_REQUIRED OPENDBC_GIT_EXECUTABLE OPENDBC_PATCH_SOURCE_DIR OPENDBC_PATCH_FILE)
    if(NOT DEFINED ${OPENDBC_REQUIRED} OR "${${OPENDBC_REQUIRED}}" STREQUAL "")
        message(FATAL_ERROR "Missing ${OPENDBC_REQUIRED} for dependency patch")
    endif()
endforeach()

execute_process(
    COMMAND "${OPENDBC_GIT_EXECUTABLE}" -C "${OPENDBC_PATCH_SOURCE_DIR}"
            apply --reverse --check "${OPENDBC_PATCH_FILE}"
    RESULT_VARIABLE OPENDBC_ALREADY_PATCHED
    OUTPUT_QUIET ERROR_QUIET)
if(OPENDBC_ALREADY_PATCHED EQUAL 0)
    return()
endif()

execute_process(
    COMMAND "${OPENDBC_GIT_EXECUTABLE}" -C "${OPENDBC_PATCH_SOURCE_DIR}"
            apply --ignore-space-change --whitespace=nowarn "${OPENDBC_PATCH_FILE}"
    RESULT_VARIABLE OPENDBC_PATCH_RESULT
    OUTPUT_VARIABLE OPENDBC_PATCH_OUTPUT
    ERROR_VARIABLE OPENDBC_PATCH_ERROR)
if(NOT OPENDBC_PATCH_RESULT EQUAL 0)
    message(FATAL_ERROR "Cannot apply ${OPENDBC_PATCH_FILE}: ${OPENDBC_PATCH_OUTPUT}${OPENDBC_PATCH_ERROR}")
endif()
