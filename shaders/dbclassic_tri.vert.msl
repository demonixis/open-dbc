vertex VSMain_out VSMain(VSMain_in in [[stage_in]], constant type_VertexUniforms& VertexUniforms [[buffer(0)]], constant type_ModelUniforms& ModelUniforms [[buffer(1)]], constant type_MeshUniforms& MeshUniforms [[buffer(2)]])
{
    VSMain_out out = {};
    float4 _131 = ModelUniforms.ModelView * float4(in.in_var_POSITION, 1.0);
    float3 _145 = in.in_var_NORMAL * float3x3(float4(MeshUniforms.NormalTransform[0][0], MeshUniforms.NormalTransform[1][0], MeshUniforms.NormalTransform[2][0], MeshUniforms.NormalTransform[3][0]).xyz, float4(MeshUniforms.NormalTransform[0][1], MeshUniforms.NormalTransform[1][1], MeshUniforms.NormalTransform[2][1], MeshUniforms.NormalTransform[3][1]).xyz, float4(MeshUniforms.NormalTransform[0][2], MeshUniforms.NormalTransform[1][2], MeshUniforms.NormalTransform[2][2], MeshUniforms.NormalTransform[3][2]).xyz);
    float3 _158;
