#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct type_VertexUniforms
{
    float4x4 ViewProj;
};

struct VSMain_out
{
    float4 out_var_TEXCOORD0 [[user(locn0)]];
    float4 gl_Position [[position]];
};

struct VSMain_in
{
    float3 in_var_POSITION [[attribute(0)]];
    float4 in_var_COLOR [[attribute(1)]];
};

vertex VSMain_out VSMain(VSMain_in in [[stage_in]], constant type_VertexUniforms& VertexUniforms [[buffer(0)]])
{
    VSMain_out out = {};
    out.gl_Position = VertexUniforms.ViewProj * float4(in.in_var_POSITION, 1.0);
    out.out_var_TEXCOORD0 = in.in_var_COLOR;
    return out;
}

