#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct type_VertexUniforms
{
    float4x4 ViewProj;
    float4x4 World;
    float4x4 NormalWorld;
};

struct type_FragmentUniforms
{
    float4 BaseColor;
    float4 Emissive;
    float4 Specular;
    float4 Ambient;
    float4 Camera;
    float4 Fog;
    float4 Flags;
    float4 LightPosition[8];
    float4 LightDirection[8];
    float4 LightColor[8];
    float4 LightCone[8];
};

struct VSMain_out
{
    float3 out_var_TEXCOORD0 [[user(locn0)]];
    float3 out_var_TEXCOORD1 [[user(locn1)]];
    float2 out_var_TEXCOORD2 [[user(locn2)]];
    float4 gl_Position [[position]];
};

struct VSMain_in
{
    float3 in_var_POSITION [[attribute(0)]];
    float3 in_var_NORMAL [[attribute(1)]];
    float2 in_var_TEXCOORD0 [[attribute(2)]];
};

vertex VSMain_out VSMain(VSMain_in in [[stage_in]], constant type_VertexUniforms& VertexUniforms [[buffer(0)]])
{
    VSMain_out out = {};
    float4 _53 = VertexUniforms.World * float4(in.in_var_POSITION, 1.0);
    out.gl_Position = VertexUniforms.ViewProj * _53;
    out.out_var_TEXCOORD0 = _53.xyz;
    out.out_var_TEXCOORD1 = in.in_var_NORMAL * float3x3(float4(VertexUniforms.NormalWorld[0][0], VertexUniforms.NormalWorld[1][0], VertexUniforms.NormalWorld[2][0], VertexUniforms.NormalWorld[3][0]).xyz, float4(VertexUniforms.NormalWorld[0][1], VertexUniforms.NormalWorld[1][1], VertexUniforms.NormalWorld[2][1], VertexUniforms.NormalWorld[3][1]).xyz, float4(VertexUniforms.NormalWorld[0][2], VertexUniforms.NormalWorld[1][2], VertexUniforms.NormalWorld[2][2], VertexUniforms.NormalWorld[3][2]).xyz);
    out.out_var_TEXCOORD2 = in.in_var_TEXCOORD0;
    return out;
}

