# Writes files into a C++ include, so the Studio needs none of them beside the executable on
# any platform. Char arrays rather than string literals, which MSVC limits to 64 KB.
# Called with: -DOUTPUT=<file.inc> -DSOURCE_DIR=<dir> -DFILES=<name;name> -DARRAY=<constant name>
set(OPENDBC_EMBED "// Generated by embed_files.cmake; do not edit.\n")
set(OPENDBC_TABLE "inline constexpr std::pair<std::string_view, std::string_view> ${ARRAY}[] = {\n")
set(OPENDBC_INDEX 0)
foreach(OPENDBC_FILE IN LISTS FILES)
    file(READ "${SOURCE_DIR}/${OPENDBC_FILE}" OPENDBC_HEX HEX)
    file(SIZE "${SOURCE_DIR}/${OPENDBC_FILE}" OPENDBC_SIZE)
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "'\\\\x\\1'," OPENDBC_BYTES "${OPENDBC_HEX}")
    string(APPEND OPENDBC_EMBED "inline constexpr char ${ARRAY}${OPENDBC_INDEX}[] = {${OPENDBC_BYTES}};\n")
    string(APPEND OPENDBC_TABLE "    {\"${OPENDBC_FILE}\", std::string_view(${ARRAY}${OPENDBC_INDEX}, ${OPENDBC_SIZE})},\n")
    math(EXPR OPENDBC_INDEX "${OPENDBC_INDEX} + 1")
endforeach()
string(APPEND OPENDBC_TABLE "};\n")
file(WRITE "${OUTPUT}.tmp" "${OPENDBC_EMBED}${OPENDBC_TABLE}")
file(COPY_FILE "${OUTPUT}.tmp" "${OUTPUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${OUTPUT}.tmp")
