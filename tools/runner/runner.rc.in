// Default icon and version of opendbc-runner. Exports replace both with the game's own
// (tools/studio/src/toolchain/windows_resources.cpp), so the IDs and language must stay as they are.
#include <windows.h>

LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL

1 ICON "@OPENDBC_RUNNER_ICON@"

1 VERSIONINFO
FILEVERSION @OPENDBC_WINDOWS_VERSION_COMMAS@
PRODUCTVERSION @OPENDBC_WINDOWS_VERSION_COMMAS@
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "OpenDBC Runner"
            VALUE "FileVersion", "@OPENDBC_VERSION@"
            VALUE "InternalName", "opendbc-runner"
            VALUE "OriginalFilename", "opendbc-runner.exe"
            VALUE "ProductName", "OpenDBC"
            VALUE "ProductVersion", "@OPENDBC_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
