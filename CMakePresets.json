{
  "version": 5,
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Desktop Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/default",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTS": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "Desktop Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTS": "OFF"
      }
    },
    {
      "name": "release-macos",
      "displayName": "macOS Release, Apple Silicon",
      "inherits": "release",
      "binaryDir": "${sourceDir}/build/release-macos",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "arm64"
      }
    },
    {
      "name": "windows-release",
      "displayName": "Windows x64 Release (MSVC developer shell)",
      "inherits": "release",
      "binaryDir": "${sourceDir}/build/windows-release",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "architecture": {
        "value": "x64",
        "strategy": "external"
      }
    },
    {
      "name": "sanitize",
      "displayName": "Desktop ASan and UBSan",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/sanitize",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "BUILD_TESTS": "ON",
        "OPENDBC_SANITIZE": "ON"
      }
    },
    {
      "name": "shader-verify",
      "displayName": "Canonical shader verification",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/shader-verify",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTS": "OFF",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "OFF",
        "OPENDBC_VERIFY_CANONICAL_SHADERS": "ON"
      }
    },
    {
      "name": "macos-xcode",
      "displayName": "macOS full app, Xcode project",
      "generator": "Xcode",
      "binaryDir": "${sourceDir}/build/macos-xcode",
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "arm64"
      }
    },
    {
      "name": "ios",
      "displayName": "iOS device app",
      "generator": "Xcode",
      "binaryDir": "${sourceDir}/build/ios",
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "iOS",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "16.0",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_XCODE_ATTRIBUTE_CODE_SIGNING_ALLOWED": "NO"
      }
    },
    {
      "name": "ios-simulator",
      "displayName": "iOS simulator app",
      "generator": "Xcode",
      "binaryDir": "${sourceDir}/build/ios-simulator",
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "iOS",
        "CMAKE_OSX_SYSROOT": "iphonesimulator",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "16.0",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_XCODE_ATTRIBUTE_CODE_SIGNING_ALLOWED": "NO"
      }
    },
    {
      "name": "ios-runtime",
      "displayName": "iOS device runtime for exported Xcode projects",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/ios-runtime",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_SYSTEM_NAME": "iOS",
        "CMAKE_OSX_SYSROOT": "iphoneos",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "16.0",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "BUILD_TESTS": "OFF"
      }
    },
    {
      "name": "ios-simulator-runtime",
      "displayName": "iOS Simulator runtime for exported Xcode projects",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/ios-simulator-runtime",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_SYSTEM_NAME": "iOS",
        "CMAKE_OSX_SYSROOT": "iphonesimulator",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "16.0",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "BUILD_TESTS": "OFF"
      }
    },
    {
      "name": "android-host",
      "displayName": "Android arm64 export host",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/android-host",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_TOOLCHAIN_FILE": "$env{ANDROID_NDK_HOME}/build/cmake/android.toolchain.cmake",
        "ANDROID_ABI": "arm64-v8a",
        "ANDROID_PLATFORM": "29",
        "ANDROID_STL": "c++_static",
        "BUILD_TESTS": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "configurePreset": "default",
      "jobs": 2
    },
    {
      "name": "release",
      "configurePreset": "release",
      "jobs": 2
    },
    {
      "name": "release-macos",
      "configurePreset": "release-macos",
      "jobs": 2
    },
    {
      "name": "windows-release",
      "configurePreset": "windows-release",
      "jobs": 2
    },
    {
      "name": "sanitize",
      "configurePreset": "sanitize",
      "jobs": 2
    },
    {
      "name": "shader-verify",
      "configurePreset": "shader-verify",
      "jobs": 2,
      "targets": [
        "opendbc_verify_shaders"
      ]
    },
    {
      "name": "shader-update",
      "configurePreset": "shader-verify",
      "targets": [
        "opendbc_update_shaders"
      ]
    },
    {
      "name": "ios-runtime",
      "configurePreset": "ios-runtime",
      "jobs": 2,
      "targets": [
        "opendbc_ios_runtime"
      ]
    },
    {
      "name": "ios-simulator-runtime",
      "configurePreset": "ios-simulator-runtime",
      "jobs": 2,
      "targets": [
        "opendbc_ios_runtime"
      ]
    },
    {
      "name": "android-host",
      "configurePreset": "android-host",
      "jobs": 2,
      "targets": [
        "opendbc_export_host_manifest"
      ]
    }
  ],
  "testPresets": [
    {
      "name": "default",
      "configurePreset": "default",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "jobs": 4,
        "timeout": 120,
        "noTestsAction": "error"
      },
      "environment": {
        "OPENDBC_HEADLESS": "1",
        "SDL_ASSERT": "abort"
      }
    },
    {
      "name": "sanitize",
      "configurePreset": "sanitize",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "jobs": 4,
        "timeout": 120,
        "noTestsAction": "error"
      },
      "environment": {
        "ASAN_OPTIONS": "abort_on_error=1:halt_on_error=1",
        "OPENDBC_HEADLESS": "1",
        "SDL_ASSERT": "abort",
        "UBSAN_OPTIONS": "halt_on_error=1:print_stacktrace=1"
      }
    }
  ]
}
