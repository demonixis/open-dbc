rem ==================================================================
rem Secret Messages - an OpenDBC tutorial for the DarkBASIC Classic profile
rem Encodes a message with a Caesar shift, one character at a time, using
rem MID$, ASC and CHR$, then takes it apart with LEFT$, RIGHT$, LEN,
rem UPPER$, LOWER$, VAL and STR$, and shows each letter's code in
rem decimal, HEX$ and BIN$. UP and DOWN change the shift.
rem Code is part of OpenDBC (MIT).
rem ==================================================================

sync on : sync rate 30
w = screen width()
message$ = "Meet me at the lighthouse at 11 tonight"
shift = 3 : changed = timer()

do
   if upkey() = 1 and held = 0 then shift = (shift + 1) mod 26 : changed = timer()
   if downkey() = 1 and held = 0 then shift = (shift + 25) mod 26 : changed = timer()
   held = upkey() + downkey()
   if timer() - changed > 2500 then shift = (shift + 1) mod 26 : changed = timer()

   secret$ = caesar$(message$, shift)
   cls rgb(20, 24, 34)

   ink rgb(255, 210, 120), 0
   text 20, 14, "SHIFT " + str$(shift) + "   (UP and DOWN change it)"
   ink rgb(230, 230, 230), 0
   text 20, 44, "Message:  " + message$
   ink rgb(120, 220, 160), 0
   text 20, 64, "Secret:   " + secret$
   ink rgb(230, 230, 230), 0
   text 20, 84, "Decoded:  " + caesar$(secret$, 26 - shift)

   rem Cutting the message up
   ink rgb(160, 190, 255), 0
   text 20, 124, "LEN = " + str$(len(message$)) + "   LEFT$(,4) = " + left$(message$, 4) + "   RIGHT$(,7) = " + right$(message$, 7)
   text 20, 144, "UPPER$ = " + upper$(message$)
   text 20, 164, "LOWER$ = " + lower$(message$)

   rem VAL turns the digits found in the text back into a number
   digits$ = ""
   for i = 1 to len(message$)
      c$ = mid$(message$, i)
      if asc(c$) >= 48 and asc(c$) <= 57 then digits$ = digits$ + c$
   next i
   text 20, 184, "Digits found: """ + digits$ + """   VAL + 1 = " + str$(val(digits$) + 1)

   rem A table of codes, laid out with SET CURSOR and PRINT in a font
   rem whose letters all have the same width
   ink rgb(255, 255, 255), 0
   set text font "Courier New"
   set cursor 20, 224
   print "CHAR  ASC   HEX$   BIN$"
   for i = 1 to 8
      c$ = mid$(secret$, i)
      code = asc(c$)
      set cursor 20, 224 + i * 20
      print " " + c$ + "    " + str$(code) + "   " + hex$(code) + "     " + right$(bin$(code), 8)
   next i
   set text font "Arial"
   sync
loop

rem Shift the letters of text$ along the alphabet, keeping their case
function caesar$(text$, shift)
   result$ = ""
   for i = 1 to len(text$)
      code = asc(mid$(text$, i))
      if code >= 65 and code <= 90 then code = 65 + (code - 65 + shift) mod 26
      if code >= 97 and code <= 122 then code = 97 + (code - 97 + shift) mod 26
      result$ = result$ + chr$(code)
   next i
endfunction result$
