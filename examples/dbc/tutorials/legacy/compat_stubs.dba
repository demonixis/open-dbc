rem ==================================================================
rem Compatibility Stubs - an OpenDBC tutorial for the DarkBASIC Classic profile
rem DarkBASIC Classic relied on Windows 98 technology that has no portable
rem equivalent today: AVI playback through Video for Windows, audio CDs,
rem FTP sessions, DirectPlay network games, DLL calls, the registry and
rem raw access to the video memory. OpenDBC still accepts every one of
rem these commands so that old programs run, but they do nothing: commands
rem return at once, numbers read 0 and strings are empty. This program
rem calls each of them and shows what it answers, one page per area.
rem Code is part of OpenDBC (MIT).
rem ==================================================================

sync on : sync rate 30
dim title$(7) : dim why$(7)
dim label$(70) : dim value$(70) : dim group(70)
n = 0

rem --- 1. AVI animations (Video for Windows)
title$(1) = "AVI ANIMATIONS" : why$(1) = "Video for Windows is gone; animations never open their file."
load animation "intro.avi", 1
place animation 1, 10, 10, 330, 250
play animation 1 : loop animation 1 : pause animation 1 : resume animation 1 : stop animation 1
g = 1
n = n + 1 : group(n) = g : label$(n) = "ANIMATION EXIST(1)" : value$(n) = str$(animation exist(1))
n = n + 1 : group(n) = g : label$(n) = "ANIMATION PLAYING(1)" : value$(n) = str$(animation playing(1))
n = n + 1 : group(n) = g : label$(n) = "ANIMATION PAUSED(1)" : value$(n) = str$(animation paused(1))
n = n + 1 : group(n) = g : label$(n) = "ANIMATION LOOPED(1)" : value$(n) = str$(animation looped(1))
n = n + 1 : group(n) = g : label$(n) = "ANIMATION LOOPING(1)" : value$(n) = str$(animation looping(1))
n = n + 1 : group(n) = g : label$(n) = "ANIMATION POSITION X(1)" : value$(n) = str$(animation position x(1))
n = n + 1 : group(n) = g : label$(n) = "ANIMATION POSITION Y(1)" : value$(n) = str$(animation position y(1))
n = n + 1 : group(n) = g : label$(n) = "ANIMATION WIDTH(1)" : value$(n) = str$(animation width(1))
n = n + 1 : group(n) = g : label$(n) = "ANIMATION HEIGHT(1)" : value$(n) = str$(animation height(1))
delete animation 1

rem --- 2. Audio CDs
title$(2) = "AUDIO CD" : why$(2) = "There is no CD drive to read audio tracks from."
load cdmusic 1, 1
n = n + 1 : group(n) = 2 : label$(n) = "LOAD CDMUSIC 1, 1 then MUSIC EXIST(1)" : value$(n) = str$(music exist(1))

rem --- 3. FTP
title$(3) = "FTP" : why$(3) = "Plain FTP is obsolete and insecure; every session fails at once."
ftp connect "ftp.example.org", "anonymous", "guest"
ftp set dir "/"
ftp find first : ftp find next
ftp get file "remote.txt", "local.txt", 1
ftp put file "local.txt"
ftp delete file "old.txt"
ftp proceed : ftp terminate : ftp disconnect 0
g = 3
n = n + 1 : group(n) = g : label$(n) = "GET FTP STATUS()" : value$(n) = str$(get ftp status())
n = n + 1 : group(n) = g : label$(n) = "GET FTP FAILURE()" : value$(n) = str$(get ftp failure())
n = n + 1 : group(n) = g : label$(n) = "GET FTP PROGRESS()" : value$(n) = str$(get ftp progress())
n = n + 1 : group(n) = g : label$(n) = "GET FTP FILE TYPE()" : value$(n) = str$(get ftp file type())
n = n + 1 : group(n) = g : label$(n) = "GET FTP FILE SIZE()" : value$(n) = str$(get ftp file size())
n = n + 1 : group(n) = g : label$(n) = "GET FTP FILE NAME$()" : value$(n) = """" + get ftp file name$() + """"
n = n + 1 : group(n) = g : label$(n) = "GET FTP DIR$()" : value$(n) = """" + get ftp dir$() + """"
n = n + 1 : group(n) = g : label$(n) = "GET FTP ERROR$()" : value$(n) = """" + get ftp error$() + """"

rem --- 4. DirectPlay network games
title$(4) = "NETWORK GAMES" : why$(4) = "DirectPlay no longer exists; no session is ever found or joined."
perform checklist for net connections
connections = checklist quantity()
set net connection 1, ""
perform checklist for net sessions
sessions = checklist quantity()
create net game "Harbour Race", "host", 4, 1
join net game 1, "guest"
perform checklist for net players
create net player "bot"
send net message integer 0, 42
send net message float 0, 1.5
send net message string 0, "hello"
send net message bitmap 0, 1, 0 : send net message image 0, 1, 0
send net message memblock 0, 1, 0 : send net message mesh 0, 1, 0 : send net message sound 0, 1, 0
get net message
net message bitmap 1 : net message image 1 : net message memblock 1 : net message mesh 1 : net message sound 1
g = 4
n = n + 1 : group(n) = g : label$(n) = "connections, sessions found" : value$(n) = str$(connections) + ", " + str$(sessions)
n = n + 1 : group(n) = g : label$(n) = "CREATE NET PLAYER(""bot2"")" : value$(n) = str$(create net player("bot2"))
n = n + 1 : group(n) = g : label$(n) = "NET GAME EXISTS()" : value$(n) = str$(net game exists())
n = n + 1 : group(n) = g : label$(n) = "NET GAME NOW HOSTING()" : value$(n) = str$(net game now hosting())
n = n + 1 : group(n) = g : label$(n) = "NET GAME LOST()" : value$(n) = str$(net game lost())
n = n + 1 : group(n) = g : label$(n) = "NET PLAYER CREATED()" : value$(n) = str$(net player created())
n = n + 1 : group(n) = g : label$(n) = "NET PLAYER DESTROYED()" : value$(n) = str$(net player destroyed())
n = n + 1 : group(n) = g : label$(n) = "NET MESSAGE EXISTS()" : value$(n) = str$(net message exists())
n = n + 1 : group(n) = g : label$(n) = "NET MESSAGE TYPE()" : value$(n) = str$(net message type())
n = n + 1 : group(n) = g : label$(n) = "NET MESSAGE PLAYER FROM()" : value$(n) = str$(net message player from())
n = n + 1 : group(n) = g : label$(n) = "NET MESSAGE PLAYER TO()" : value$(n) = str$(net message player to())
n = n + 1 : group(n) = g : label$(n) = "NET MESSAGE INTEGER()" : value$(n) = str$(net message integer())
n = n + 1 : group(n) = g : label$(n) = "NET MESSAGE FLOAT()" : value$(n) = str$(net message float())
n = n + 1 : group(n) = g : label$(n) = "NET MESSAGE STRING$()" : value$(n) = """" + net message string$() + """"
free net player 1
free net game

rem --- 5. DLLs and the registry
title$(5) = "DLLS AND REGISTRY" : why$(5) = "Windows DLLs and the registry do not exist on other systems."
load dll "user32.dll", 1
call dll 1, "MessageBeep", 0
write to registry "Software\OpenDBC", "Score", 10
g = 5
n = n + 1 : group(n) = g : label$(n) = "DLL EXIST(1)" : value$(n) = str$(dll exist(1))
n = n + 1 : group(n) = g : label$(n) = "DLL CALL EXIST(1, ""MessageBeep"")" : value$(n) = str$(dll call exist(1, "MessageBeep"))
n = n + 1 : group(n) = g : label$(n) = "CALL DLL(1, ""GetTickCount"")" : value$(n) = str$(call dll(1, "GetTickCount"))
n = n + 1 : group(n) = g : label$(n) = "GET REGISTRY(""Software\OpenDBC"", ""Score"")" : value$(n) = str$(get registry("Software\OpenDBC", "Score"))
n = n + 1 : group(n) = g : label$(n) = "WINDIR$()" : value$(n) = """" + windir$() + """"
delete dll 1

rem --- 6. Video memory and old hardware switches
title$(6) = "HARDWARE" : why$(6) = "Modern graphics hide video memory and need no software emulation."
lock backbuffer
make memblock 1, 16
set graphics card "Primary Display Driver"
disable tnl : enable tnl
set emulation on : set emulation off
disable systemkeys : enable systemkeys
set eax 1
g = 6
n = n + 1 : group(n) = g : label$(n) = "GET BACKBUFFER PTR()" : value$(n) = str$(get backbuffer ptr())
n = n + 1 : group(n) = g : label$(n) = "GET MEMBLOCK PTR(1)" : value$(n) = str$(get memblock ptr(1))
n = n + 1 : group(n) = g : label$(n) = "EMULATION MODE()" : value$(n) = str$(emulation mode())
n = n + 1 : group(n) = g : label$(n) = "3DBLIT AVAILABLE()" : value$(n) = str$(3dblit available())
unlock backbuffer
delete memblock 1

pages = 6 : page = 1 : changed = timer()
do
   if timer() - changed > 4000 or (rightkey() = 1 and held = 0) then page = (page mod pages) + 1 : changed = timer()
   held = rightkey()
   cls rgb(26, 30, 40)
   ink rgb(255, 200, 90), 0
   text 20, 14, "COMPATIBILITY STUBS - page " + str$(page) + " of " + str$(pages) + ": " + title$(page)
   ink rgb(190, 190, 210), 0
   text 20, 38, why$(page)
   y = 76
   for i = 1 to n
      if group(i) = page
         ink rgb(230, 230, 230), 0 : text 30, y, label$(i)
         ink rgb(120, 220, 160), 0 : text 420, y, value$(i)
         y = y + 22
      endif
   next i
   ink rgb(140, 140, 160), 0
   text 20, screen height() - 30, "Every command on this page ran without error. RIGHT shows the next page."
   sync
loop
