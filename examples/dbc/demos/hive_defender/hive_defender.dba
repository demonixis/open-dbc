rem ==================================================================
rem Hive Defender - an OpenDBC example for the DarkBASIC Classic profile
rem Hold the line against a swarm of hive drones. They sway in formation,
rem then break off one by one to dive at your ship; now and then their
rem mothership crosses the sky for a bonus.
rem LEFT/RIGHT move, SPACE fires. Without the keys the ship fights alone.
rem Code and media are part of OpenDBC (MIT code, CC0 media).
rem ==================================================================

sync on : sync rate 60
hide mouse
autocam off
randomize timer()
color backdrop 0
set ambient light 70
position camera 0, -12, -115
point camera 0, 4, 0

cols = 8 : rows = 4 : drones = cols * rows
dim slotx(drones) : dim sloty(drones) : dim state(drones) : dim dx#(drones) : dim dy#(drones)
dim divet#(drones) : dim divedir(drones)
dim boltx#(8) : dim bolty#(8) : dim boltlife(8)
dim boom(8)

gosub build_scene
gosub new_wave
lives = 3 : score = 0 : wave = 1
px# = 0.0 : shot = 0 : invulnerable = 120

do
   t = t + 1
   gosub move_player
   gosub move_formation
   gosub launch_dive
   for d = 1 to drones
      if state(d) > 0 then gosub update_drone
   next d
   gosub move_bolts
   gosub move_mothership
   gosub update_explosions
   scroll object texture 1, 0, -0.0004
   gosub draw_hud
   sync
loop

rem ------------------------------------------------------------------
build_scene:
   rem The nebula: a large plain behind the playfield
   load image "textures/nebula.jpg", 1
   make object plain 1, 460, 350
   texture object 1, 1
   position object 1, 0, 0, 80
   set object 1, 1, 0, 0, 1, 0, 0, 0
   rem The player's ship points up the screen with its top towards us
   load object "models/ship.x", 2
   scale object 2, 150, 150, 150
   rotate object 2, -90, 0, 0
   rem The mothership: its ring (limb 3) spins
   load object "models/mothership.x", 3
   scale object 3, 220, 220, 220
   rotate object 3, -65, 0, 0
   hide object 3
   rem The player's laser and the drones' bolts: ghosted, so they glow
   make object box 5, 0.6, 5, 0.6
   color object 5, rgb(120, 220, 255)
   ghost object on 5
   hide object 5
   for b = 1 to 8
      make object sphere 50 + b, 1.6
      color object 50 + b, rgb(120, 255, 90)
      ghost object on 50 + b
      hide object 50 + b
   next b
   rem Three drone colours, one texture each; the top row is amber
   load image "textures/drone_amber.jpg", 2
   load image "textures/drone_violet.jpg", 3
   load image "textures/drone_green.jpg", 4
   for d = 1 to drones
      load object "models/drone.x", 10 + d
      scale object 10 + d, 140, 140, 140
      row = (d - 1) / cols
      if row = 0 then texture object 10 + d, 2
      if row = 1 or row = 2 then texture object 10 + d, 3
      if row = 3 then texture object 10 + d, 4
   next d
   rem Explosion frames: eight 128 x 128 cells from one strip
   load bitmap "textures/explosions.png", 1
   for f = 0 to 7
      get image 100 + f, f * 128, 0, f * 128 + 128, 128
   next f
   delete bitmap 1
   for b = 1 to 8
      make object plain 200 + b, 14, 14
      texture object 200 + b, 100
      ghost object on 200 + b
      hide object 200 + b
   next b
   load sound "sounds/laser.wav", 1
   load sound "sounds/boom.wav", 2
   load sound "sounds/swoop.wav", 3
   load sound "sounds/hum.wav", 4
   load sound "sounds/hit.wav", 5
return

new_wave:
   for d = 1 to drones
      slotx(d) = ((d - 1) mod cols) * 12 - (cols - 1) * 6
      sloty(d) = 52 - ((d - 1) / cols) * 9
      state(d) = 1
      dx#(d) = slotx(d) : dy#(d) = sloty(d) + 60 + rnd(30)
      show object 10 + d
   next d
   alive = drones
return

rem ------------------------------------------------------------------
move_player:
   move = rightkey() - leftkey()
   if move = 0 and leftkey() + rightkey() = 0
      rem Autopilot: line up under the lowest diving drone, else under the swarm
      goal# = px# : lowest# = 1000.0
      for d = 1 to drones
         if state(d) = 2 and dy#(d) < lowest# then lowest# = dy#(d) : goal# = dx#(d)
      next d
      if lowest# = 1000.0
         for d = drones to 1 step -1
            if state(d) = 1 then goal# = dx#(d) : exit
         next d
      endif
      if goal# > px# + 1 then move = 1
      if goal# < px# - 1 then move = -1
      autofire = (abs(goal# - px#) < 4)
   else
      autofire = 0
   endif
   px# = px# + move * 0.9
   if px# < -55 then px# = -55
   if px# > 55 then px# = 55
   position object 2, px#, -42, 0
   rotate object 2, -90, 0, 0 - move * 20
   if invulnerable > 0
      dec invulnerable
      if (invulnerable / 6) mod 2 = 0 then hide object 2 else show object 2
      if invulnerable = 0 then show object 2
   endif

   rem One laser at a time
   if (spacekey() = 1 or autofire = 1) and shot = 0 and lives > 0
      shot = 1 : shotx# = px# : shoty# = -37
      show object 5
      play sound 1
   endif
   if shot = 1
      shoty# = shoty# + 2.4
      position object 5, shotx#, shoty#, 0
      if shoty# > 70 then shot = 0 : hide object 5
   endif
return

rem The formation sways from side to side while the drones beat their wings
move_formation:
   sway# = sin(t * 0.8) * 9
   for d = 1 to drones
      if state(d) = 1
         dx#(d) = slotx(d) + sway#
         dy#(d) = curvevalue(sloty(d), dy#(d), 20)
         position object 10 + d, dx#(d), dy#(d), 0
         rotate object 10 + d, -90, 0, 180
      endif
      if state(d) > 0
         flap# = sin(t * 18 + d * 40) * 35
         rotate limb 10 + d, 4, 0, 0, flap#
         rotate limb 10 + d, 5, 0, 0, 0 - flap#
      endif
   next d
return

rem Now and then a drone from the formation starts a dive
launch_dive:
   if t mod (90 - wave * 8) <> 0 or lives <= 0 then return
   d = 1 + rnd(drones - 1)
   if state(d) = 1
      state(d) = 2 : divet#(d) = 0 : divedir(d) = rnd(1) * 2 - 1
      play sound 3
   endif
return

rem State 1 in formation, 2 diving, 3 flying back to its slot
update_drone:
   if state(d) = 2
      divet#(d) = divet#(d) + 1
      dx#(d) = dx#(d) + sin(divet#(d) * 2.5) * 0.9 * divedir(d) + (px# - dx#(d)) * 0.004
      dy#(d) = dy#(d) - 0.55 - wave * 0.05
      rem Bank into the turn: the roll follows the sideways speed
      rotate object 10 + d, -90, 0, 180 + cos(divet#(d) * 2.5) * 40 * divedir(d)
      if divet#(d) = 40 or divet#(d) = 80 then gosub drone_fires
      if dy#(d) < -60 then dy#(d) = 70 : state(d) = 3
   endif
   if state(d) = 3
      dx#(d) = curvevalue(slotx(d) + sway#, dx#(d), 15)
      dy#(d) = curvevalue(sloty(d), dy#(d), 15)
      rotate object 10 + d, -90, 0, 180
      if abs(dy#(d) - sloty(d)) < 0.5 then state(d) = 1
   endif
   position object 10 + d, dx#(d), dy#(d), 0

   rem The laser hits a drone
   if shot = 1
      if abs(shotx# - dx#(d)) < 4 and abs(shoty# - dy#(d)) < 4
         if state(d) = 2 then score = score + 80 else score = score + 30
         state(d) = 0 : hide object 10 + d
         shot = 0 : hide object 5
         x# = dx#(d) : y# = dy#(d) : gosub start_boom
         dec alive
         if alive = 0 then inc wave : gosub new_wave
      endif
   endif
   rem A diving drone rams the ship
   if state(d) = 2 and invulnerable = 0 and abs(dx#(d) - px#) < 5 and abs(dy#(d) + 42) < 4
      state(d) = 0 : hide object 10 + d : dec alive
      x# = dx#(d) : y# = dy#(d) : gosub start_boom
      gosub ship_hit
      if alive = 0 then inc wave : gosub new_wave
   endif
return

drone_fires:
   for b = 1 to 8
      if boltlife(b) = 0
         boltlife(b) = 160 : boltx#(b) = dx#(d) : bolty#(b) = dy#(d) - 3
         show object 50 + b
         exit
      endif
   next b
return

move_bolts:
   for b = 1 to 8
      if boltlife(b) > 0
         dec boltlife(b)
         bolty#(b) = bolty#(b) - 0.9
         position object 50 + b, boltx#(b), bolty#(b), 0
         if invulnerable = 0 and abs(boltx#(b) - px#) < 3.5 and abs(bolty#(b) + 42) < 3
            boltlife(b) = 0
            gosub ship_hit
         endif
         if bolty#(b) < -60 then boltlife(b) = 0
         if boltlife(b) = 0 then hide object 50 + b
      endif
   next b
return

ship_hit:
   x# = px# : y# = -42 : gosub start_boom
   play sound 5
   dec lives
   invulnerable = 150
   if lives <= 0 then lives = 3 : score = 0 : wave = 1 : gosub new_wave
return

rem The mothership crosses the top of the screen every twenty seconds
move_mothership:
   if mother = 0 and t mod 1200 = 600 then mother = 1 : motherx# = -90 : loop sound 4
   if mother = 1
      motherx# = motherx# + 0.35
      position object 3, motherx#, 70, 5
      show object 3
      ring# = wrapvalue(ring# + 6)
      rotate limb 3, 3, 0, ring#, 0
      if shot = 1 and abs(shotx# - motherx#) < 14 and abs(shoty# - 70) < 5
         score = score + 500
         shot = 0 : hide object 5
         x# = motherx# : y# = 70 : gosub start_boom
         x# = motherx# + 6 : gosub start_boom
         motherx# = 100
      endif
      if motherx# > 90 then mother = 0 : hide object 3 : stop sound 4
   endif
return

rem Explosions play the eight frames of the strip on a ghosted plain
start_boom:
   b = 1 + (boomnext mod 8) : inc boomnext
   boom(b) = 32
   position object 200 + b, x#, y#, -2
   show object 200 + b
   play sound 2
return

update_explosions:
   for b = 1 to 8
      if boom(b) > 0
         dec boom(b)
         texture object 200 + b, 100 + (31 - boom(b)) / 4
         if boom(b) = 0 then hide object 200 + b
      endif
   next b
return

draw_hud:
   ink rgb(255, 255, 255), 0
   text 12, 8, "SCORE " + str$(score)
   center text screen width() / 2, 8, "WAVE " + str$(wave)
   text screen width() - 110, 8, "SHIPS " + str$(lives)
return
