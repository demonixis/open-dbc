rem Sky Gardens - the garden: every island, seed and checkpoint placed from DATA, and
rem the route the title screen runs. Included by sky_gardens.dba.

rem Level: every piece is placed from the DATA below. Heights are tops
rem of walkable surfaces; blocks and pillars give their bottom.
function build_level()
   nextObject = FIRST_OBJECT
   restore level_data
   repeat
      read kind$
      select kind$
         case "island"
            read x#, y#, z#, r#
            o = new_object()
            clone object o, 900
            show object o
            position object o, x#, y#, z#
            scale object o, r# * 100, (r# * 0.6 + 2.0) * 100, r# * 100
            yrotate object o, rnd(359)
            scale object texture o, r# / 3.0, r# / 3.0
            set bump mapping on o, 10
            add_solid(2, x#, z#, r#, r#, y# - 1.5, y#, o)
            scatter_ferns(x#, y#, z#, r#)
         endcase
         case "block"
            read x#, y#, z#, w#, h#, d#
            o = make_block(x#, y#, z#, w#, h#, d#, 4)
            s = add_solid(1, x#, z#, w# / 2, d# / 2, y#, y# + h#, o)
            if h# >= 6 then solids(s).wall = 1
         endcase
         case "pillar"
            read x#, y#, z#, r#, h#
            o = new_object()
            make object cylinder o, 1
            scale object o, r# * 200, h# * 100, r# * 200
            position object o, x#, y# + h# / 2, z#
            texture object o, 4
            scale object texture o, 2, h# / 4
            set bump mapping on o, 5
            add_solid(2, x#, z#, r#, r#, y#, y# + h#, o)
         endcase
         case "mover"
            read x#, y#, z#, w#, d#, ax#, ay#, az#, period#
            o = make_block(x#, y#, z#, w#, 1.0, d#, 7)
            inc moverCount
            movers(moverCount).solid = add_solid(1, x#, z#, w# / 2, d# / 2, y#, y# + 1.0, o)
            movers(moverCount).ox = x# : movers(moverCount).oy = y# : movers(moverCount).oz = z#
            movers(moverCount).ax = ax# : movers(moverCount).ay = ay# : movers(moverCount).az = az#
            movers(moverCount).period = period#
            movers(moverCount).phase = moverCount * 120.0
         endcase
         case "seed"
            read x#, y#, z#, m
            add_seed(x#, y#, z#, m)
         endcase
         case "check"
            read x#, y#, z#, r
            inc checkCount
            o = new_object()
            clone object o, 904
            show object o
            position object o, x#, y#, z#
            yrotate object o, 200
            color limb o, 2, rgb(150, 150, 160)
            cull_add(o, x#, z#, 150)
            checks(checkCount).obj = o
            checks(checkCount).x = x# : checks(checkCount).y = y# : checks(checkCount).z = z#
            checks(checkCount).route = r
            add_solid(2, x#, z#, 0.3, 0.3, y#, y# + 6.0, o)
         endcase
         case "arch"
            read x#, y#, z#
            o = new_object()
            clone object o, 901
            show object o
            position object o, x#, y#, z#
            set bump mapping on o, 5
            cull_add(o, x#, z#, 180)
            add_solid(1, x# - 3.5, z#, 0.7, 0.7, y#, y# + 7.0, 0)
            add_solid(1, x# + 3.5, z#, 0.7, 0.7, y#, y# + 7.0, 0)
            add_solid(1, x#, z#, 4.7, 0.9, y# + 7.0, y# + 8.4, 0)
         endcase
         case "tree"
            read x#, y#, z#, s#
            o = new_object()
            clone object o, 902
            show object o
            position object o, x#, y#, z#
            scale object o, s# * 100, s# * 100, s# * 100
            yrotate object o, rnd(359)
            cull_add(o, x#, z#, 160)
            add_solid(2, x#, z#, 0.45 * s#, 0.45 * s#, y#, y# + 4.6 * s#, o)
         endcase
         case "lantern"
            read x#, y#, z#
            o = new_object()
            clone object o, 903
            show object o
            position object o, x#, y#, z#
            set object emissive o, rgb(70, 50, 20)
            inc lanternCount
            lanterns(lanternCount) = o
            cull_add(o, x#, z#, 120)
            add_solid(1, x#, z#, 0.4, 0.4, y#, y# + 3.3, o)
         endcase
         case "pad"
            read x#, y#, z#
            o = new_object()
            clone object o, 905
            show object o
            rem Sunk into the grass so the cap is a step the explorer runs onto
            position object o, x#, y# - 1.5, z#
            set object specular o, rgb(255, 255, 255)
            set object specular power o, 20
            cull_add(o, x#, z#, 150)
            s = add_solid(2, x#, z#, 2.0, 2.0, y# - 1.5, y# + 0.4, o)
            solids(s).bounce = 1
         endcase
         case "shrine"
            read x#, y#, z#
            o = new_object()
            clone object o, 906
            show object o
            rem The dais is sunk to a single step
            position object o, x#, y# - 0.4, z#
            set bump mapping on o, 5
            set object specular o, rgb(255, 220, 160)
            set object specular power o, 18
            shrineX# = x# : shrineY# = y# + 0.4 : shrineZ# = z#
            add_solid(2, x#, z#, 6.0, 6.0, y# - 0.4, y# + 0.4, o)
            for c = 0 to 5
               add_solid(2, x# + 5 * cos(c * 60), z# + 5 * sin(c * 60), 0.5, 0.5, y#, y# + 9.0, 0)
            next c
            rem The crystal the seeds wake up
            o = new_object()
            clone object o, 907
            show object o
            scale object o, 260, 260, 260
            position object o, x#, y# + 5.0, z#
            set object emissive o, rgb(60, 60, 60)
            set object specular o, rgb(203, 203, 203)
            set object specular power o, 400
            shrineCrystal = o
            position light 5, x#, y# + 6.0, z#
         endcase
      endselect
   until kind$ = "end"
endfunction

rem The attract route: where the autopilot runs, leaps or waits for a mover
function build_route()
   restore route_data
   repeat
      read x#, z#, m, leap, chimney
      if x# > -999
         inc routeCount
         route(routeCount).x = x# : route(routeCount).z = z#
         route(routeCount).mover = m : route(routeCount).leap = leap : route(routeCount).chimney = chimney
      endif
   until x# <= -999
endfunction

level_data:

rem Route for the autopilot: x, z, mover to follow, leap from here, chimney climb
route_data:
data 0, -4, 0, 0, 0
data 0, 14.5, 0, 1, 0
data 0, 27, 0, 0, 0
data 2.5, 31.5, 0, 1, 0
data 7, 41, 0, 0, 0
data 5, 45, 0, 1, 0
data 0, 55, 0, 0, 0
data 0, 60, 0, 1, 0
data 0, 78, 0, 0, 0
data 0, 81, 0, 1, 0
data 0, 84, 0, 1, 0
data 0, 87.5, 0, 1, 0
data 0, 0, 1, 1, 0
data 0, 0, 2, 1, 0
data 0, 0, 3, 1, 0
data 0, 131, 0, 0, 0
data 0, 140, 0, 0, 0
data 0, 146, 0, 0, 1
data 0, 151, 0, 1, 0
data 0, 165, 0, 0, 0
data 0, 170, 0, 0, 0
data 0, 192, 0, 0, 0
data 0, 199, 0, 1, 0
data 0, 205, 0, 1, 0
data -4, 214, 0, 1, 0
data 2, 223, 0, 1, 0
data 0, 240, 0, 0, 0
data 0, 250, 0, 0, 0
data -1000, 0, 0, 0, 0

function new_object()
   o = nextObject
   inc nextObject
endfunction o

function add_solid(kind, x#, z#, hx#, hz#, bottom#, top#, o)
   inc solidCount
   solids(solidCount).kind = kind
   solids(solidCount).x = x# : solids(solidCount).z = z#
   solids(solidCount).hx = hx# : solids(solidCount).hz = hz#
   solids(solidCount).bottom = bottom# : solids(solidCount).top = top#
   solids(solidCount).obj = o
endfunction solidCount

rem A box whose UVs are projected from its faces, so stone courses keep their size
function make_block(x#, y#, z#, w#, h#, d#, image)
   o = new_object()
   make object box o, w#, h#, d#
   position object o, x#, y# + h# / 2, z#
   texture object o, image
   rem MAKE OBJECT BOX lists six vertices per face: a face is the axis they all share
   lock vertexdata for limb o, 0
   for b = 0 to get vertexdata vertex count() - 1 step 6
      axis = 3
      sameX = 1 : sameY = 1
      for v = b + 1 to b + 5
         if abs(get vertexdata position x(v) - get vertexdata position x(b)) > 0.001 then sameX = 0
         if abs(get vertexdata position y(v) - get vertexdata position y(b)) > 0.001 then sameY = 0
      next v
      if sameY = 1 then axis = 2
      if sameX = 1 then axis = 1
      for v = b to b + 5
         vx# = get vertexdata position x(v) + x# : vy# = get vertexdata position y(v) + y# + h# / 2
         vz# = get vertexdata position z(v) + z#
         select axis
            case 1 : set vertexdata uv v, vz# / 6.0, 0 - vy# / 6.0 : endcase
            case 2 : set vertexdata uv v, vx# / 6.0, vz# / 6.0 : endcase
            case 3 : set vertexdata uv v, vx# / 6.0, 0 - vy# / 6.0 : endcase
         endselect
      next v
   next b
   unlock vertexdata
   if image = 4 then set bump mapping on o, 5
   if image = 7 then set bump mapping on o, 11
   set object specular o, rgb(70, 60, 50)
   set object specular power o, 8
endfunction o

function add_seed(x#, y#, z#, m)
   inc seedCount
   o = new_object()
   clone object o, 907
   show object o
   scale object o, 70, 70, 70
   set object emissive o, rgb(40, 160, 120)
   set object specular o, rgb(188, 188, 188)
   set object specular power o, 40
   h = new_object()
   make object plain h, 3.2, 3.2
   texture object h, 6
   ghost object on h
   set object light h, 0
   disable object zwrite h
   seeds(seedCount).obj = o : seeds(seedCount).halo = h
   seeds(seedCount).x = x# : seeds(seedCount).y = y# : seeds(seedCount).z = z#
   seeds(seedCount).mover = m
endfunction

rem Crossed alpha-tested cards of grass around an island
function scatter_ferns(x#, y#, z#, r#)
   count = int(r# / 3.0)
   for f = 1 to count
      a# = rnd(359) : d# = (r# - 1.0) * (0.35 + rnd(60) / 100.0)
      fx# = x# + sin(a#) * d# : fz# = z# + cos(a#) * d#
      for c = 0 to 1
         o = new_object()
         make object plain o, 1.6, 1.6
         texture object o, 8
         set object transparency o, 4
         set object cull o, 0
         position object o, fx#, y# + 0.78, fz#
         yrotate object o, a# + c * 90
         cull_add(o, fx#, fz#, 90)
      next c
   next f
endfunction
