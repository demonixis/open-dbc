REM OpenDBC world settings. Edited by the Studio Scene view.
FUNCTION SetupWorld_SkyGardens()
   SET DISPLAY MODE 1280, 720, 32
   SYNC ON
   SYNC RATE 60
   HIDE MOUSE
   AUTOCAM OFF
   SET AMBIENT LIGHT 46
   COLOR AMBIENT LIGHT RGB(160, 150, 190)
   POSITION CAMERA 0, 10, -20
   ROTATE CAMERA 0, 0, 0
   SET CAMERA FOV 65
   SET CAMERA RANGE 0.5, 4000
ENDFUNCTION
