rem ------------------------------------------------------------------
function new_object()
   o = nextObject
   inc nextObject
endfunction o

function add_solid(kind, x#, z#, hx#, hz#, bottom#, top#, o)
   inc solidCount
   solids(solidCount).kind = kind
   solids(solidCount).x = x# : solids(solidCount).z = z#
   solids(solidCount).hx = hx# : solids(solidCount).hz = hz#
   solids(solidCount).bottom = bottom# : solids(solidCount).top = top#
   solids(solidCount).obj = o
endfunction solidCount

rem A box whose UVs are projected from its faces, so stone courses keep their size
function make_block(x#, y#, z#, w#, h#, d#, image)
   o = new_object()
   make object box o, w#, h#, d#
   position object o, x#, y# + h# / 2, z#
   texture object o, image
   rem MAKE OBJECT BOX lists six vertices per face: a face is the axis they all share
   lock vertexdata for limb o, 0
   for b = 0 to get vertexdata vertex count() - 1 step 6
      axis = 3
      sameX = 1 : sameY = 1
      for v = b + 1 to b + 5
         if abs(get vertexdata position x(v) - get vertexdata position x(b)) > 0.001 then sameX = 0
         if abs(get vertexdata position y(v) - get vertexdata position y(b)) > 0.001 then sameY = 0
      next v
      if sameY = 1 then axis = 2
      if sameX = 1 then axis = 1
      for v = b to b + 5
         vx# = get vertexdata position x(v) + x# : vy# = get vertexdata position y(v) + y# + h# / 2
         vz# = get vertexdata position z(v) + z#
         select axis
            case 1 : set vertexdata uv v, vz# / 6.0, 0 - vy# / 6.0 : endcase
            case 2 : set vertexdata uv v, vx# / 6.0, vz# / 6.0 : endcase
            case 3 : set vertexdata uv v, vx# / 6.0, 0 - vy# / 6.0 : endcase
         endselect
      next v
   next b
   unlock vertexdata
   if image = 4 then set object normal map o, 5
   if image = 7 then set object normal map o, 11
   set object specular o, rgb(70, 60, 50)
   set object specular power o, 8
endfunction o

function add_seed(x#, y#, z#, m)
   inc seedCount
   o = new_object()
   clone object o, 907
   show object o
   scale object o, 70, 70, 70
   set object emissive o, rgb(40, 160, 120)
   set object specular o, rgb(255, 255, 255)
   set object specular power o, 40
   set object cube map o, 1, 0.5
   h = new_object()
   make object plain h, 3.2, 3.2
   texture object h, 6
   ghost object on h
   set object light h, 0
   disable object zwrite h
   seeds(seedCount).obj = o : seeds(seedCount).halo = h
   seeds(seedCount).x = x# : seeds(seedCount).y = y# : seeds(seedCount).z = z#
   seeds(seedCount).mover = m
endfunction

rem Crossed alpha-tested cards of grass around an island
function scatter_ferns(x#, y#, z#, r#)
   count = int(r# / 3.0)
   for f = 1 to count
      a# = rnd(359) : d# = (r# - 1.0) * (0.35 + rnd(60) / 100.0)
      fx# = x# + sin(a#) * d# : fz# = z# + cos(a#) * d#
      for c = 0 to 1
         o = new_object()
         make object plain o, 1.6, 1.6
         texture object o, 8
         set object transparency o, 4
         set object cull o, 0
         position object o, fx#, y# + 0.78, fz#
         yrotate object o, a# + c * 90
         cull_add(o, fx#, fz#, 90)
      next c
   next f
endfunction

function activate_check(c)
   lastCheck = c
   checks(c).lit = 1
   color limb checks(c).obj, 2, rgb(255, 196, 60)
endfunction

function respawn()
   px# = checks(lastCheck).x - 3.0 : py# = checks(lastCheck).y + 0.5 : pz# = checks(lastCheck).z + 3.0
   vx# = 0 : vy# = 0 : vz# = 0 : heading# = 0
   onGround = 0 : jumps = 0 : wallTimer = 0 : controlLock = 0 : groundSolid = 0 : nearCount = 0
   autoStep = checks(lastCheck).route
   camX# = px# - sin(camYaw#) * 11 : camY# = py# + 5 : camZ# = pz# - cos(camYaw#) * 11
endfunction

function set_anim(a)
   if a = anim then exitfunction
   anim = a
   select a
      case ANIM_IDLE : loop object 1, 0, 40 : endcase
      case ANIM_RUN : loop object 1, 41, 61 : endcase
      case ANIM_JUMP : play object 1, 62, 71 : endcase
      case ANIM_FALL : loop object 1, 73, 83 : endcase
      case ANIM_WALL : loop object 1, 84, 94 : endcase
   endselect
endfunction

function update_movers()
   for m = 1 to moverCount
      s = movers(m).solid
      t# = wrapvalue((frame * 360.0) / movers(m).period + movers(m).phase)
      nx# = movers(m).ox + sin(t#) * movers(m).ax
      ny# = movers(m).oy + sin(t#) * movers(m).ay
      nz# = movers(m).oz + sin(t#) * movers(m).az
      movers(m).dx = nx# - solids(s).x : movers(m).dy = ny# - solids(s).bottom : movers(m).dz = nz# - solids(s).z
      solids(s).x = nx# : solids(s).z = nz#
      solids(s).top = ny# + (solids(s).top - solids(s).bottom) : solids(s).bottom = ny#
      position object solids(s).obj, nx#, ny# + 0.5, nz#
   next m
endfunction

rem Horizontal overlap of the explorer's circle with a solid's footprint
function overlaps(s)
   if solids(s).kind = 1
      cx# = px# : cz# = pz#
      if cx# < solids(s).x - solids(s).hx then cx# = solids(s).x - solids(s).hx
      if cx# > solids(s).x + solids(s).hx then cx# = solids(s).x + solids(s).hx
      if cz# < solids(s).z - solids(s).hz then cz# = solids(s).z - solids(s).hz
      if cz# > solids(s).z + solids(s).hz then cz# = solids(s).z + solids(s).hz
      d# = (px# - cx#) ^ 2 + (pz# - cz#) ^ 2
      result = (d# < PLAYER_RADIUS * PLAYER_RADIUS * 0.5)
   else
      d# = sqrt((px# - solids(s).x) ^ 2 + (pz# - solids(s).z) ^ 2)
      result = (d# < solids(s).hx + PLAYER_RADIUS * 0.4)
   endif
endfunction result

function seed_on_mover(s)
   if seeds(s).mover > 0
      ms = movers(seeds(s).mover).solid
      seeds(s).x = solids(ms).x : seeds(s).z = solids(ms).z
      seeds(s).y = solids(ms).top + 1.6
   endif
endfunction

function gather_near()
   nearCount = 0
   for s = 1 to solidCount
      if abs(px# - solids(s).x) - solids(s).hx < 24 and abs(pz# - solids(s).z) - solids(s).hz < 24
         inc nearCount
         nearSolid(nearCount) = s
      endif
   next s
endfunction

function cull_add(o, x#, z#, range#)
   inc cullCount
   cullObj(cullCount) = o : cullX#(cullCount) = x# : cullZ#(cullCount) = z#
   cullRange#(cullCount) = range# * range# : cullShown(cullCount) = 1
endfunction

function cull_scenery()
   for c = 1 to cullCount
      d# = (cullX#(c) - camX#) ^ 2 + (cullZ#(c) - camZ#) ^ 2
      if d# < cullRange#(c)
         if cullShown(c) = 0 then show object cullObj(c) : cullShown(c) = 1
      else
         if cullShown(c) = 1 then hide object cullObj(c) : cullShown(c) = 0
      endif
   next c
endfunction

rem Highest top whose footprint holds a point: where the autopilot will land
function top_at(x#, z#)
   top# = -1000.0
   for s = 1 to solidCount
      if solids(s).top > top#
         if solids(s).kind = 1
            if abs(x# - solids(s).x) <= solids(s).hx and abs(z# - solids(s).z) <= solids(s).hz then top# = solids(s).top
         else
            if (x# - solids(s).x) ^ 2 + (z# - solids(s).z) ^ 2 <= solids(s).hx ^ 2 then top# = solids(s).top
         endif
      endif
   next s
endfunction top#

rem Highest walkable top under the feet that a step or a fall can reach
function find_ground()
   ground# = -1000.0 : groundSolid = 0
   rem Standing explorers climb small steps; falling ones only land on what they cross
   reach# = py# + 0.05
   if onGround = 1 or vy# >= 0 then reach# = py# + 0.45
   for n = 1 to nearCount
      s = nearSolid(n)
      if solids(s).top <= reach# and solids(s).top > ground#
         if overlaps(s) = 1 then ground# = solids(s).top : groundSolid = s
      endif
   next n
endfunction ground#

function ceiling_check()
   if vy# <= 0 then exitfunction
   for n = 1 to nearCount
      s = nearSolid(n)
      if solids(s).kind = 1 and solids(s).bottom >= py# + PLAYER_HEIGHT - 0.2
         if solids(s).bottom < py# + PLAYER_HEIGHT + vy#
            if overlaps(s) = 1 then vy# = 0.0
         endif
      endif
   next n
endfunction

rem Push the explorer out of every solid it walks into; tall blocks become wall-jump walls
function push_out()
   for n = 1 to nearCount
      s = nearSolid(n)
      if solids(s).top > py# + 0.45 and solids(s).bottom < py# + PLAYER_HEIGHT
         if solids(s).kind = 1
            cx# = px# : cz# = pz#
            if cx# < solids(s).x - solids(s).hx then cx# = solids(s).x - solids(s).hx
            if cx# > solids(s).x + solids(s).hx then cx# = solids(s).x + solids(s).hx
            if cz# < solids(s).z - solids(s).hz then cz# = solids(s).z - solids(s).hz
            if cz# > solids(s).z + solids(s).hz then cz# = solids(s).z + solids(s).hz
            dx# = px# - cx# : dz# = pz# - cz#
            d# = sqrt(dx# * dx# + dz# * dz#)
            if d# < PLAYER_RADIUS
               if d# < 0.0001
                  rem Centre inside the box: leave by the nearest face
                  ex# = solids(s).hx - abs(px# - solids(s).x) : ez# = solids(s).hz - abs(pz# - solids(s).z)
                  if ex# < ez#
                     dx# = 1.0 : dz# = 0
                     if px# < solids(s).x then dx# = -1.0
                     px# = solids(s).x + dx# * (solids(s).hx + PLAYER_RADIUS)
                  else
                     dz# = 1.0 : dx# = 0
                     if pz# < solids(s).z then dz# = -1.0
                     pz# = solids(s).z + dz# * (solids(s).hz + PLAYER_RADIUS)
                  endif
               else
                  dx# = dx# / d# : dz# = dz# / d#
                  px# = cx# + dx# * PLAYER_RADIUS : pz# = cz# + dz# * PLAYER_RADIUS
               endif
               rem Cancel the velocity into the wall
               dot# = vx# * dx# + vz# * dz#
               if dot# < 0 then vx# = vx# - dot# * dx# : vz# = vz# - dot# * dz#
               if solids(s).wall = 1 and onGround = 0 then wallTimer = 8 : wallNx# = dx# : wallNz# = dz#
            endif
         else
            dx# = px# - solids(s).x : dz# = pz# - solids(s).z
            d# = sqrt(dx# * dx# + dz# * dz#)
            limit# = solids(s).hx + PLAYER_RADIUS
            if d# < limit# and d# > 0.0001
               dx# = dx# / d# : dz# = dz# / d#
               px# = solids(s).x + dx# * limit# : pz# = solids(s).z + dz# * limit#
               dot# = vx# * dx# + vz# * dz#
               if dot# < 0 then vx# = vx# - dot# * dx# : vz# = vz# - dot# * dz#
            endif
         endif
      endif
   next n
endfunction

function title_image(image, t$, height)
   cls 0
   shadow_text(640, 4, t$, 1)
   get image image, 0, 0, 1280, height, 1
endfunction

function shadow_text(x, y, t$, centred)
   if centred = 1 then x = x - text width(t$) / 2
   ink rgb(60, 30, 20), 0
   text x + 2, y + 2, t$
   ink rgb(255, 246, 228), 0
   text x, y, t$
endfunction
