rem ==================================================================
rem Sky Gardens - an OpenDBC example for the DarkBASIC Professional profile
rem Run, jump and wall-jump across floating garden islands at golden
rem hour, gather the thirty glowing seeds and wake the shrine at the top.
rem WASD or arrows move, SPACE jumps (again in the air for a double jump,
rem against a tall wall for a wall jump), the mouse orbits the camera,
rem ESC quits. The title screen plays itself until a key or click.
rem Code and media are part of OpenDBC (MIT code, CC0 media).
rem ==================================================================

rem The display, the camera lens, the ambient light, the sky dome and the sun disc are a
rem level of the Studio's Scene view: open levels/SkyGardens there to edit them.
#include "levels/SkyGardens/world_settings.dba"
#include "levels/SkyGardens/SkyGardens.dba"
#include "garden.dba"
#include "player.dba"
#include "scenery.dba"
#include "hud.dba"
SetupWorld_SkyGardens()
LoadLevel_SkyGardens()

randomize 7

#constant GRAVITY 0.032
#constant JUMP_SPEED 0.56
#constant BOUNCE_SPEED 1.2
#constant RUN_SPEED 0.30
#constant PLAYER_RADIUS 0.6
#constant PLAYER_HEIGHT 2.9
#constant SEED_TOTAL 30
#constant FIRST_OBJECT 100
#constant FOG_RGB rgb(250, 214, 172)

rem Animation timeline of explorer.x: looping clips end on their first pose
#constant ANIM_IDLE 1
#constant ANIM_RUN 2
#constant ANIM_JUMP 3
#constant ANIM_FALL 4
#constant ANIM_WALL 5

type Solid
   kind as integer
   x as float
   z as float
   hx as float
   hz as float
   bottom as float
   top as float
   obj as integer
   bounce as integer
   wall as integer
endtype

type Mover
   solid as integer
   ox as float
   oy as float
   oz as float
   ax as float
   ay as float
   az as float
   period as float
   phase as float
   dx as float
   dy as float
   dz as float
endtype

type Seed
   obj as integer
   halo as integer
   x as float
   y as float
   z as float
   mover as integer
   taken as integer
   shown as integer
endtype

type Checkpoint
   obj as integer
   x as float
   y as float
   z as float
   lit as integer
   route as integer
endtype

type Waypoint
   x as float
   z as float
   mover as integer
   leap as integer
   chimney as integer
endtype

dim solids(120) as Solid
dim movers(6) as Mover
dim seeds(SEED_TOTAL) as Seed
dim checks(6) as Checkpoint
dim route(60) as Waypoint
dim lanterns(12) as integer
dim best#(3)
dim bestSeed(3)
rem Physics only tests the solids near the explorer, refreshed every few frames
dim nearSolid(120)
dim nearSeed(SEED_TOTAL)
rem Small scenery hides beyond its range: OpenDBC rebuilds every visible triangle each frame
dim cullObj(200)
dim cullX#(200)
dim cullZ#(200)
dim cullRange#(200)
dim cullShown(200)

rem One name per GLOBAL: a comma list would only make the first one global
global solidCount : global moverCount : global seedCount : global checkCount : global routeCount : global lanternCount : global nextObject
global px# : global py# : global pz# : global vx# : global vy# : global vz# : global heading# : global onGround : global groundSolid : global coyote : global jumps : global lastJump
global wallTimer : global wallNx# : global wallNz# : global controlLock : global anim : global landDust
global camYaw# : global camPitch# : global camX# : global camY# : global camZ# : global idleCamera
global seedsTaken : global lastCheck : global startTime : global finishTime : global finished : global attract : global message$ : global messageTime
global inputX# : global inputZ# : global inputJump : global holdJump
global autoStep : global autoWait
global sunX# : global sunY# : global sunZ# : global frame
global nearCount : global nearSeedCount : global cullCount : global autoTop# : global autoTopStep
rem What one function sets for another, or keeps from one frame to the next
global shrineX# : global shrineY# : global shrineZ# : global shrineCrystal
global burst : global flash : global bounceSquash : global lastSpace

load_media()
build_level()
build_route()
attract = 1
new_run()

rem ------------------------------------------------------------------
do
   inc frame
   if attract = 1
      autopilot()
      if scancode() > 1 or mouseclick() > 0
         attract = 0
         for i = 1 to 3 : hide sprite i : next i
         show sprite 4
         new_run()
      endif
   else
      read_controls()
   endif
   if escapekey() = 1 then end

   update_movers()
   if finished = 0 then move_player()
   collect_seeds()
   check_progress()
   animate_player()
   update_camera()
   update_scenery()
   draw_hud()
   sync
loop

rem ------------------------------------------------------------------
function new_run()
   for s = 1 to seedCount
      seeds(s).taken = 0 : seeds(s).shown = 0
      hide object seeds(s).obj : hide object seeds(s).halo
   next s
   nearSeedCount = -1
   for c = 1 to checkCount
      checks(c).lit = 0
      color limb checks(c).obj, 2, rgb(150, 150, 160)
   next c
   seedsTaken = 0 : finished = 0 : finishTime = 0
   lastCheck = 1
   activate_check(1)
   respawn()
   camYaw# = 0 : camPitch# = 18 : camX# = px# : camY# = py# + 6 : camZ# = pz# - 14
   startTime = timer()
   message$ = "" : messageTime = 0
   set object emissive shrineCrystal, rgb(60, 60, 60)
   set light range 5, 45
endfunction

rem ------------------------------------------------------------------
function check_progress()
   for c = 1 to checkCount
      if checks(c).lit = 0
         dx# = checks(c).x - px# : dz# = checks(c).z - pz#
         if dx# * dx# + dz# * dz# < 36 and abs(checks(c).y - py#) < 3
            activate_check(c)
            play sound 5
            message$ = "CHECKPOINT" : messageTime = 120
         endif
      endif
      rotate limb checks(c).obj, 2, 0, sin(frame * 2 + c * 50) * 12, 0
   next c

   rem The shrine wakes once the explorer stands in its ring
   if finished = 0
      dx# = shrineX# - px# : dz# = shrineZ# - pz#
      if dx# * dx# + dz# * dz# < 12 and py# >= shrineY# - 0.1
         finished = 1 : finishTime = timer() - startTime : autoWait = 0
         vx# = 0 : vz# = 0
         play sound 7
         set object emissive shrineCrystal, rgb(255, 230, 160)
         set light range 5, 90
         position particles 1, shrineX#, shrineY# + 5, shrineZ#
         set particle emissions 1, 20
         burst = 40
         if seedsTaken = SEED_TOTAL
            message$ = "THE GARDEN BLOOMS - EVERY SEED FOUND"
         else
            message$ = "SHRINE AWAKENED - " + str$(seedsTaken) + " OF " + str$(SEED_TOTAL) + " SEEDS"
         endif
         messageTime = 100000
      endif
   endif
endfunction

rem ------------------------------------------------------------------
function update_camera()
   rem When nobody touches the mouse, swing round behind the explorer
   speed# = sqrt(vx# * vx# + vz# * vz#)
   if idleCamera > 40 and speed# > 0.1 then camYaw# = curveangle(heading#, camYaw#, 45)
   if attract = 1 then camYaw# = curveangle(heading#, camYaw#, 60) : camPitch# = curvevalue(16 + sin(frame * 0.3) * 6, camPitch#, 60)
   distance# = 12.0
   targetY# = py# + 2.2
   wantX# = px# - sin(camYaw#) * cos(camPitch#) * distance#
   wantY# = targetY# + sin(camPitch#) * distance#
   wantZ# = pz# - cos(camYaw#) * cos(camPitch#) * distance#
   camX# = curvevalue(wantX#, camX#, 6)
   camY# = curvevalue(wantY#, camY#, 8)
   camZ# = curvevalue(wantZ#, camZ#, 6)
   position camera camX#, camY#, camZ#
   point camera px#, targetY#, pz#
endfunction

rem ------------------------------------------------------------------
rem Start island with its arch, trees and lanterns
data "island", 0, 0, 0, 16
data "arch", 0, 0, 6
data "tree", -10, 0, -3, 1.2, "tree", 10, 0, 3, 1.0, "tree", -6, 0, 11, 0.8
data "lantern", -5, 0, -12, "lantern", 6, 0, 12
data "check", 4, 0, -10, 1
data "seed", 0, 1.6, 6, 0, "seed", -7, 1.6, 9, 0, "seed", 8, 1.6, -4, 0, "seed", 12, 1.6, -8, 0
rem A chain of small islands climbing gently
data "island", 0, 1.5, 27, 6, "seed", 0, 3.1, 27, 0
data "island", 7, 3, 41, 5, "seed", 7, 4.6, 41, 0
data "island", 0, 4.5, 55, 6, "seed", 0, 6.1, 55, 0
data "seed", 0, 10, 65, 0
rem Ruined courtyard with steps up to the moving platforms
data "island", 0, 6, 80, 11
data "block", -8, 6, 80, 2, 5, 10, "block", 8, 6, 82, 2, 3, 8
data "block", 0, 6, 84, 6, 2, 3, "block", 0, 6, 87, 6, 4, 3
data "lantern", -4, 6, 73, "lantern", 4, 6, 73
data "tree", -6, 6, 86, 0.9
data "check", 5, 6, 75, 9
data "seed", -5, 7.6, 78, 0, "seed", 5, 7.6, 84, 0, "seed", 0, 11.6, 87, 0
rem Three sliding platforms over the gap, each carrying a seed
data "mover", 0, 9, 97, 5, 5, 7, 0, 0, 240
data "mover", 0, 10, 108, 5, 5, 7, 0, 0, 220
data "mover", 0, 11, 119, 5, 5, 6, 0, 0, 200
data "seed", 0, 0, 0, 1, "seed", 0, 0, 0, 2, "seed", 0, 0, 0, 3
rem Landing island and the wall-jump chimney
data "island", 0, 12, 136, 8
data "check", 5, 12, 132, 16
data "lantern", -5, 12, 131
data "seed", -4, 13.6, 138, 0, "seed", 4, 13.6, 140, 0
data "block", 0, 11, 146, 5, 1, 8
data "block", -3.5, 12, 146, 2, 18, 8, "block", 3.5, 12, 146, 2, 18, 8
data "block", 0, 12, 151, 9, 18, 2
data "seed", 0, 17, 146, 0, "seed", 0, 23, 146, 0, "seed", 0, 32, 151, 0
rem High island with the bounce mushroom
data "island", 0, 30, 165, 7, "seed", -3, 31.6, 163, 0, "seed", 3, 31.6, 163, 0
data "pad", 0, 30, 170
data "seed", 0, 42.5, 173, 0, "seed", 0, 49.5, 176, 0
data "island", 0, 44, 192, 8
data "check", 5, 44, 188, 22
data "tree", -5, 44, 194, 0.9, "lantern", 4, 44, 196
data "seed", -3, 45.6, 190, 0
rem Pillar hops to the shrine
data "pillar", 0, 30, 205, 2, 15, "pillar", -4, 30, 214, 2, 16, "pillar", 2, 30, 223, 2, 17
data "seed", 0, 46.6, 205, 0, "seed", -4, 47.6, 214, 0, "seed", 2, 48.6, 223, 0
data "island", 0, 48, 245, 14
data "arch", 0, 48, 236
data "tree", -9, 48, 248, 1.3, "tree", 9, 48, 246, 1.1
data "lantern", -5, 48, 240, "lantern", 5, 48, 240
data "seed", -8, 49.6, 240, 0, "seed", 8, 49.6, 240, 0, "seed", 0, 49.6, 233, 0
data "shrine", 0, 48, 250
data "end"

rem ------------------------------------------------------------------

function activate_check(c)
   lastCheck = c
   checks(c).lit = 1
   color limb checks(c).obj, 2, rgb(255, 196, 60)
endfunction
