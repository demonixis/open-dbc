rem Sky Gardens - the explorer: controls, the autopilot, movement against the solids
rem and animation. Included by sky_gardens.dba.

function read_controls()
   fx# = sin(camYaw#) : fz# = cos(camYaw#)
   ax# = 0.0 : az# = 0.0
   if upkey() = 1 or keystate(17) = 1 then ax# = ax# + fx# : az# = az# + fz#
   if downkey() = 1 or keystate(31) = 1 then ax# = ax# - fx# : az# = az# - fz#
   if rightkey() = 1 or keystate(32) = 1 then ax# = ax# + fz# : az# = az# - fx#
   if leftkey() = 1 or keystate(30) = 1 then ax# = ax# - fz# : az# = az# + fx#
   length# = sqrt(ax# * ax# + az# * az#)
   if length# > 0.01 then ax# = ax# / length# : az# = az# / length#
   inputX# = ax# : inputZ# = az#
   inputJump = spacekey() : holdJump = inputJump
   mx = mousemovex() : my = mousemovey()
   if mx <> 0 or my <> 0
      camYaw# = wrapvalue(camYaw# + mx * 0.25)
      camPitch# = camPitch# + my * 0.2
      if camPitch# < 4 then camPitch# = 4
      if camPitch# > 60 then camPitch# = 60
      idleCamera = 0
   else
      inc idleCamera
   endif
   if finished = 1 and inputJump = 1 and lastSpace = 0 then new_run()
   lastSpace = inputJump
endfunction

rem The autopilot presses the same virtual controls as the player
function autopilot()
   inputX# = 0.0 : inputZ# = 0.0 : inputJump = 0 : holdJump = 0
   idleCamera = 100
   if finished = 1
      inc autoWait
      if autoWait > 240 then new_run()
      exitfunction
   endif
   if autoStep > routeCount or py# < -20 then exitfunction
   tx# = route(autoStep).x : tz# = route(autoStep).z
   m = route(autoStep).mover
   if m > 0 then tx# = solids(movers(m).solid).x : tz# = solids(movers(m).solid).z

   rem Climb the chimney: jump at one wall, then at every wall touched
   if route(autoStep).chimney = 1 and abs(tz# - pz#) < 4.5
      if py# >= 27.0
         inc autoStep
         exitfunction
      endif
      holdJump = 1
      if onGround = 1
         inputX# = 1.0 : inputJump = frame mod 2
      else
         speed# = sqrt(vx# * vx# + vz# * vz#)
         if speed# > 0.05 then inputX# = vx# / speed#
         if wallTimer > 0 then inputJump = frame mod 2
      endif
      exitfunction
   endif

   dx# = tx# - px# : dz# = tz# - pz#
   distance# = sqrt(dx# * dx# + dz# * dz#)
   if onGround = 1
      arrived = 0
      if m > 0
         if groundSolid = movers(m).solid then arrived = 1
      else
         if distance# < 1.2 then arrived = 1
      endif
      if arrived = 1
         if route(autoStep).leap = 0 or autoStep = routeCount
            inc autoStep
            exitfunction
         endif
         rem Leap points wait until the next platform lines up
         nx# = route(autoStep + 1).x : nz# = route(autoStep + 1).z
         ready = 1
         nm = route(autoStep + 1).mover
         if nm > 0
            nx# = solids(movers(nm).solid).x : nz# = solids(movers(nm).solid).z
            if abs(nx# - px#) > 1.2 then ready = 0
         else
            if m > 0
               if abs(solids(movers(m).solid).x - movers(m).ox) > 1.5 then ready = 0
            endif
         endif
         if ready = 0
            if distance# > 0.8 then inputX# = dx# / distance# * 0.4 : inputZ# = dz# / distance# * 0.4
            exitfunction
         endif
         inc autoStep
         dx# = nx# - px# : dz# = nz# - pz# : distance# = sqrt(dx# * dx# + dz# * dz#)
         inputJump = 1 : holdJump = 1
         inputX# = dx# / distance# : inputZ# = dz# / distance#
         exitfunction
      endif
      rem Ease off before a stop so the explorer does not overshoot it
      scale# = 1.0
      if route(autoStep).leap = 0 and distance# < 2.0 then scale# = distance# / 2.0 + 0.2
      if distance# > 0.1 then inputX# = dx# / distance# * scale# : inputZ# = dz# / distance# * scale#
   else
      rem In the air: aim for the landing surface, double jump if it is out of reach
      holdJump = 1
      if vy# > 0.8 and distance# < 3.0
         rem Launched by the mushroom: head for the next stop
         inc autoStep
         exitfunction
      endif
      if autoTopStep <> autoStep then autoTop# = top_at(tx#, tz#) : autoTopStep = autoStep
      disc# = vy# * vy# + 2.0 * GRAVITY * (py# - autoTop#)
      if disc# < 0
         t# = vy# / GRAVITY
      else
         t# = (vy# + sqrt(disc#)) / GRAVITY
      endif
      if t# < 1 then t# = 1
      if jumps = 1 and vy# < 0.05 and (disc# < 0 or distance# > t# * 0.27) then inputJump = 1
      scale# = distance# / t# / RUN_SPEED
      if scale# > 1.0 then scale# = 1.0
      if distance# > 0.1 then inputX# = dx# / distance# * scale# : inputZ# = dz# / distance# * scale#
   endif
endfunction

function move_player()
   if frame mod 8 = 0 or nearCount = 0 then gather_near()

   rem Ride the platform under the feet
   if onGround = 1 and groundSolid > 0
      for m = 1 to moverCount
         if movers(m).solid = groundSolid then px# = px# + movers(m).dx : py# = py# + movers(m).dy : pz# = pz# + movers(m).dz
      next m
   endif

   rem Run: accelerate towards the stick, less grip in the air
   grip# = 0.20
   if onGround = 0 then grip# = 0.07
   if controlLock > 0 then dec controlLock : grip# = 0.0
   vx# = vx# + (inputX# * RUN_SPEED - vx#) * grip#
   vz# = vz# + (inputZ# * RUN_SPEED - vz#) * grip#
   speed# = sqrt(vx# * vx# + vz# * vz#)
   if speed# > 0.03 then heading# = curveangle(atanfull(vx#, vz#), heading#, 5)

   rem Jump, double jump and wall jump on the press, not while held
   pressed = 0
   if inputJump = 1 and lastJump = 0 then pressed = 1
   lastJump = inputJump
   if pressed = 1
      if onGround = 1 or coyote > 0
         vy# = JUMP_SPEED : jumps = 1 : onGround = 0 : coyote = 0
         play sound 1
      else
         if wallTimer > 0
            vy# = JUMP_SPEED * 0.95 : vx# = wallNx# * 0.34 : vz# = wallNz# * 0.34
            heading# = atanfull(vx#, vz#) : controlLock = 10 : jumps = 1 : wallTimer = 0
            play sound 1
         else
            if jumps < 2
               vy# = JUMP_SPEED * 0.85 : jumps = 2
               set sound speed 1, 26000 : play sound 1 : set sound speed 1, 22050
               landDust = 6
            endif
         endif
      endif
   endif
   rem A short tap gives a short hop
   if holdJump = 0 and vy# > 0.15 then vy# = vy# - 0.03

   px# = px# + vx# : pz# = pz# + vz#
   push_out()
   if wallTimer > 0 then dec wallTimer

   vy# = vy# - GRAVITY
   if wallTimer > 0 and vy# < -0.10 then vy# = -0.10
   if vy# < -1.2 then vy# = -1.2
   ceiling_check()
   wasGround = onGround
   ground# = find_ground()
   if vy# <= 0 and py# + vy# <= ground#
      py# = ground#
      if wasGround = 0 and vy# < -0.3 then play sound 2 : landDust = 5
      vy# = 0.0 : onGround = 1 : jumps = 0 : coyote = 6
      if solids(groundSolid).bounce = 1
         vy# = BOUNCE_SPEED : onGround = 0 : jumps = 1
         play sound 4
         bounceSquash = 12
      endif
   else
      py# = py# + vy#
      onGround = 0
      if coyote > 0 then dec coyote
   endif

   if py# < -40 then play sound 6 : respawn()
endfunction

function animate_player()
   position object 1, px#, py#, pz#
   yrotate object 1, heading#
   speed# = sqrt(vx# * vx# + vz# * vz#)
   if onGround = 1
      if speed# > 0.04
         set_anim(ANIM_RUN)
         set object speed 1, 12 + speed# * 110
      else
         set_anim(ANIM_IDLE)
         set object speed 1, 20
      endif
   else
      if wallTimer > 0 and vy# < 0
         set_anim(ANIM_WALL)
      else
         if vy# > 0.05 then set_anim(ANIM_JUMP) else set_anim(ANIM_FALL)
      endif
      set object speed 1, 30
   endif

   if landDust > 0
      dec landDust
      position particles 2, px#, py# + 0.2, pz#
      set particle emissions 2, 3
      if landDust = 0 then set particle emissions 2, 0
   endif

   rem The bounce mushroom squashes and springs back
   if bounceSquash > 0
      dec bounceSquash
      for s = 1 to solidCount
         if solids(s).bounce = 1
            squash# = 100 - sin(bounceSquash * 15) * 25
            scale limb solids(s).obj, 1, 100 + (100 - squash#), squash#, 100 + (100 - squash#)
         endif
      next s
   endif

   rem Short stencil shadows: the light sits far along the sun direction
   set shadow position -1, px# + sunX# * 300, py# + sunY# * 300, pz# + sunZ# * 300
endfunction

function respawn()
   px# = checks(lastCheck).x - 3.0 : py# = checks(lastCheck).y + 0.5 : pz# = checks(lastCheck).z + 3.0
   vx# = 0 : vy# = 0 : vz# = 0 : heading# = 0
   onGround = 0 : jumps = 0 : wallTimer = 0 : controlLock = 0 : groundSolid = 0 : nearCount = 0
   autoStep = checks(lastCheck).route
   camX# = px# - sin(camYaw#) * 11 : camY# = py# + 5 : camZ# = pz# - cos(camYaw#) * 11
endfunction

function set_anim(a)
   if a = anim then exitfunction
   anim = a
   select a
      case ANIM_IDLE : loop object 1, 0, 40 : endcase
      case ANIM_RUN : loop object 1, 41, 61 : endcase
      case ANIM_JUMP : play object 1, 62, 71 : endcase
      case ANIM_FALL : loop object 1, 73, 83 : endcase
      case ANIM_WALL : loop object 1, 84, 94 : endcase
   endselect
endfunction

rem Horizontal overlap of the explorer's circle with a solid's footprint
function overlaps(s)
   if solids(s).kind = 1
      cx# = px# : cz# = pz#
      if cx# < solids(s).x - solids(s).hx then cx# = solids(s).x - solids(s).hx
      if cx# > solids(s).x + solids(s).hx then cx# = solids(s).x + solids(s).hx
      if cz# < solids(s).z - solids(s).hz then cz# = solids(s).z - solids(s).hz
      if cz# > solids(s).z + solids(s).hz then cz# = solids(s).z + solids(s).hz
      d# = (px# - cx#) ^ 2 + (pz# - cz#) ^ 2
      result = (d# < PLAYER_RADIUS * PLAYER_RADIUS * 0.5)
   else
      d# = sqrt((px# - solids(s).x) ^ 2 + (pz# - solids(s).z) ^ 2)
      result = (d# < solids(s).hx + PLAYER_RADIUS * 0.4)
   endif
endfunction result

function gather_near()
   nearCount = 0
   for s = 1 to solidCount
      if abs(px# - solids(s).x) - solids(s).hx < 24 and abs(pz# - solids(s).z) - solids(s).hz < 24
         inc nearCount
         nearSolid(nearCount) = s
      endif
   next s
endfunction

rem Highest top whose footprint holds a point: where the autopilot will land
function top_at(x#, z#)
   top# = -1000.0
   for s = 1 to solidCount
      if solids(s).top > top#
         if solids(s).kind = 1
            if abs(x# - solids(s).x) <= solids(s).hx and abs(z# - solids(s).z) <= solids(s).hz then top# = solids(s).top
         else
            if (x# - solids(s).x) ^ 2 + (z# - solids(s).z) ^ 2 <= solids(s).hx ^ 2 then top# = solids(s).top
         endif
      endif
   next s
endfunction top#

rem Highest walkable top under the feet that a step or a fall can reach
function find_ground()
   ground# = -1000.0 : groundSolid = 0
   rem Standing explorers climb small steps; falling ones only land on what they cross
   reach# = py# + 0.05
   if onGround = 1 or vy# >= 0 then reach# = py# + 0.45
   for n = 1 to nearCount
      s = nearSolid(n)
      if solids(s).top <= reach# and solids(s).top > ground#
         if overlaps(s) = 1 then ground# = solids(s).top : groundSolid = s
      endif
   next n
endfunction ground#

function ceiling_check()
   if vy# <= 0 then exitfunction
   for n = 1 to nearCount
      s = nearSolid(n)
      if solids(s).kind = 1 and solids(s).bottom >= py# + PLAYER_HEIGHT - 0.2
         if solids(s).bottom < py# + PLAYER_HEIGHT + vy#
            if overlaps(s) = 1 then vy# = 0.0
         endif
      endif
   next n
endfunction

rem Push the explorer out of every solid it walks into; tall blocks become wall-jump walls
function push_out()
   for n = 1 to nearCount
      s = nearSolid(n)
      if solids(s).top > py# + 0.45 and solids(s).bottom < py# + PLAYER_HEIGHT
         if solids(s).kind = 1
            cx# = px# : cz# = pz#
            if cx# < solids(s).x - solids(s).hx then cx# = solids(s).x - solids(s).hx
            if cx# > solids(s).x + solids(s).hx then cx# = solids(s).x + solids(s).hx
            if cz# < solids(s).z - solids(s).hz then cz# = solids(s).z - solids(s).hz
            if cz# > solids(s).z + solids(s).hz then cz# = solids(s).z + solids(s).hz
            dx# = px# - cx# : dz# = pz# - cz#
            d# = sqrt(dx# * dx# + dz# * dz#)
            if d# < PLAYER_RADIUS
               if d# < 0.0001
                  rem Centre inside the box: leave by the nearest face
                  ex# = solids(s).hx - abs(px# - solids(s).x) : ez# = solids(s).hz - abs(pz# - solids(s).z)
                  if ex# < ez#
                     dx# = 1.0 : dz# = 0
                     if px# < solids(s).x then dx# = -1.0
                     px# = solids(s).x + dx# * (solids(s).hx + PLAYER_RADIUS)
                  else
                     dz# = 1.0 : dx# = 0
                     if pz# < solids(s).z then dz# = -1.0
                     pz# = solids(s).z + dz# * (solids(s).hz + PLAYER_RADIUS)
                  endif
               else
                  dx# = dx# / d# : dz# = dz# / d#
                  px# = cx# + dx# * PLAYER_RADIUS : pz# = cz# + dz# * PLAYER_RADIUS
               endif
               rem Cancel the velocity into the wall
               dot# = vx# * dx# + vz# * dz#
               if dot# < 0 then vx# = vx# - dot# * dx# : vz# = vz# - dot# * dz#
               if solids(s).wall = 1 and onGround = 0 then wallTimer = 8 : wallNx# = dx# : wallNz# = dz#
            endif
         else
            dx# = px# - solids(s).x : dz# = pz# - solids(s).z
            d# = sqrt(dx# * dx# + dz# * dz#)
            limit# = solids(s).hx + PLAYER_RADIUS
            if d# < limit# and d# > 0.0001
               dx# = dx# / d# : dz# = dz# / d#
               px# = solids(s).x + dx# * limit# : pz# = solids(s).z + dz# * limit#
               dot# = vx# * dx# + vz# * dz#
               if dot# < 0 then vx# = vx# - dot# * dx# : vz# = vz# - dot# * dz#
            endif
         endif
      endif
   next n
endfunction
