rem Sky Gardens - texts: the title sprites, the seed count and the timer.
rem Included by sky_gardens.dba.

function draw_hud()
   if attract = 1
      if (frame / 30) mod 2 = 0 then show sprite 2 else hide sprite 2
      exitfunction
   endif
   set text size 34
   shadow_text(100, 30, str$(seedsTaken) + " / " + str$(SEED_TOTAL), 0)
   elapsed = timer() - startTime
   if finished = 1 then elapsed = finishTime
   seconds = elapsed / 1000
   tenths$ = str$((elapsed mod 1000) / 100)
   secs$ = str$(seconds mod 60)
   if len(secs$) < 2 then secs$ = "0" + secs$
   set text size 28
   shadow_text(screen width() - 170, 30, str$(seconds / 60) + ":" + secs$ + "." + tenths$, 0)
   if messageTime > 0
      dec messageTime
      set text size 40
      shadow_text(screen width() / 2, 150, message$, 1)
      if finished = 1
         set text size 24
         shadow_text(screen width() / 2, 205, "PRESS SPACE TO PLAY AGAIN", 1)
      endif
   endif
endfunction

function title_image(image, t$, height)
   cls 0
   shadow_text(640, 4, t$, 1)
   get image image, 0, 0, 1280, height, 1
endfunction

function shadow_text(x, y, t$, centred)
   if centred = 1 then x = x - text width(t$) / 2
   ink rgb(60, 30, 20), 0
   text x + 2, y + 2, t$
   ink rgb(255, 246, 228), 0
   text x, y, t$
endfunction
