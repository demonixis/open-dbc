data "room", -14, -90, 14, -50, 36
data "room", -90, -50, 90, 130, 90
data "room", 90, 26, 150, 54, 36
data "room", 150, -10, 230, 90, 56
data "room", -150, 26, -90, 54, 36
data "room", -230, -10, -150, 90, 56
data "room", -14, 130, 14, 190, 36
data "room", -32, 190, 32, 236, 44
rem pillar: x, z, width / pump: x, z, radius / console: x, z, facing
data "pillar", -55, -15, 14
data "pillar", 55, -15, 14
data "pillar", -55, 95, 14
data "pillar", 55, 95, 14
data "core", 0, 40, 22
data "pump", 175, 28, 9
data "pump", 205, 28, 9
