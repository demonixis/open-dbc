data "crate", -212, 2, 14, 0
data "valve", 228, 40, 270
data "valve", -228, 40, 90
data "valve", 0, 16, 180
rem drone, medkit, cell: x, z / start: x, z, facing / field: x1, z, x2 / exit: x, z
data "drone", 0, -120
data "drone", -40, 15
data "drone", 40, 70
data "drone", 0, 110
data "drone", 190, 60
data "drone", 200, 8
data "drone", -190, 40
data "drone", -170, 8
data "medkit", 34, -160
data "medkit", -80, 120
