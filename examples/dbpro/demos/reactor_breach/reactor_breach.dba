rem World animation and effects

rem ------------------------------------------------------------------
rem HUD

rem ------------------------------------------------------------------
tour:
data 12
data 0, -160, 0, -110, 0, -60, -45, -25, -65, 45, -30, 110, 30, 112, 65, 50
data 120, 40, 190, 40, 120, 40, 40, -30

rem layout:begin
layout:
