rem ==================================================================
rem Reactor Breach - an OpenDBC example for the DarkBASIC Professional profile
rem The research reactor is in lockdown and its security drones have
rem turned on the staff. Close the three coolant valves to drop the
rem force field, then reach the exit lift before the core melts down.
rem WASD or arrow keys move, the mouse aims, left button fires, R reloads,
rem hold E at a valve to close it, SPACE jumps, ESC quits.
rem Code and media are part of OpenDBC (MIT code, CC0 media).
rem ==================================================================

rem The display, the camera lens, the ambient light and the ceiling lamps are a level of
rem the Studio's Scene view: open levels/ReactorBreach there to edit them.
#include "levels/ReactorBreach/world_settings.dba"
#include "levels/ReactorBreach/ReactorBreach.dba"
#include "facility.dba"
#include "player.dba"
#include "drones.dba"
#include "hud.dba"
SetupWorld_ReactorBreach()
LoadLevel_ReactorBreach()

disable escapekey
backdrop on

rem LEVEL_TILING matches the Blender bake of the level: it turns the
rem lightmap atlas UVs back into material repeats of 32 world units.
#constant LEVEL_TILING 21.7687
#constant EYE 16.0
#constant RADIUS 4.5
#constant MAX_ROOMS 12
#constant MAX_BOXES 40
#constant MAX_DRONES 8
#constant MAX_BOLTS 10
#constant MAX_PICKUPS 8
#constant CORE_SECONDS 420

rem Object numbers
#constant OBJ_LEVEL 1
#constant OBJ_LAMPS 2
#constant OBJ_GLASS 3
#constant OBJ_ENERGY 4
#constant OBJ_FIELD 5
#constant OBJ_PAD 6
#constant OBJ_GUN 7
#constant OBJ_FLASH 8
#constant OBJ_BEACON 9
#constant OBJ_CRATE 10
#constant OBJ_VALVE 30
#constant OBJ_DRONE 40
#constant OBJ_HALO 50
#constant OBJ_BOLT 60
#constant OBJ_PICKUP 80
#constant OBJ_BLOB 90
#constant OBJ_SHINY 110

type Room
   x1 as float
   z1 as float
   x2 as float
   z2 as float
   height as float
endtype

type Drone
   x as float
   z as float
   homex as float
   homez as float
   yaw as float
   phase as float
   hp as integer
   state as integer
   anim as integer
   cooldown as integer
   sight as integer
   room as integer
   lost as integer
   postx as float
   postz as float
endtype

type Bolt
   x as float
   y as float
   z as float
   vx as float
   vy as float
   vz as float
   life as integer
   light as integer
endtype

type Pickup
   x as float
   z as float
   kind as integer
   taken as integer
endtype

type Valve
   x as float
   z as float
   facing as float
   turn as float
   closed as integer
endtype

type Crate
   x as float
   z as float
   size as float
   yaw as float
endtype

type Box
   x1 as float
   y1 as float
   z1 as float
   x2 as float
   y2 as float
   z2 as float
   cx as float
   cz as float
   radius as float
endtype

dim rooms(MAX_ROOMS) as Room
dim boxes(MAX_BOXES) as Box
dim drones(MAX_DRONES) as Drone
dim bolts(MAX_BOLTS) as Bolt
dim pickups(MAX_PICKUPS) as Pickup
dim valves(3) as Valve
dim crates(20) as Crate
dim path#(24, 2)

rem GLOBAL takes one variable per statement.
global roomcount
global boxcount
global tallcount
global dronecount
global pickupcount
global valvecount
global cratecount
global pathcount
global startx#
global startz#
global startyaw#
global fieldx1#
global fieldz#
global fieldx2#
global exitx#
global exitz#
global corex#
global corez#
global px#
global py#
global pz#
global vy#
global yaw#
global pitch#
global bob#
global recoil#
global grounded
global health
global ammo
global reserve
global reload
global cooldown
global flash
global hurt
global kills
global closedcount
global fieldon
global mode
global modetimer
global starttime
global remaining
global message$
global messagetime
global nextlight
global attract#
global flashlight
global sparkframes
global boomframes
global lookx#
global roomhint
global playerroom
global clipnear#
global clipfar#
global lookz#

make vector3 1
make vector3 2

read_layout()
roomhint = 1
load_media()
build_world()
reset_game()
mode = 0

rem ------------------------------------------------------------------
rem Main loop. mode 0 is the title with the attract tour, 1 is play,
rem 2 is defeat and 3 is victory.
do
   if mode = 0 then attract_camera() else player_update()
   if mode < 2 then drones_update()
   bolts_update()
   world_update()
   effects_update()
   draw_hud()
   if keystate(1) = 1 then end
   sync
loop

rem ------------------------------------------------------------------

function reset_game()
   playerroom = 1
   px# = startx# : pz# = startz# : py# = EYE : yaw# = startyaw# : pitch# = 0 : vy# = 0
   health = 100 : ammo = 24 : reserve = 72 : reload = 0 : cooldown = 0 : hurt = 0 : kills = 0
   closedcount = 0 : fieldon = 1 : nextlight = 5 : message$ = "" : flashlight = 0
   show object OBJ_FIELD
   build_collision()
   for i = 1 to valvecount
      valves(i).turn = 0 : valves(i).closed = 0
      rotate limb OBJ_VALVE + i - 1, 2, 0, 0, 0
   next i
   for i = 1 to dronecount
      d = OBJ_DRONE + i
      drones(i).homex = drones(i).postx : drones(i).homez = drones(i).postz
      drones(i).x = drones(i).homex : drones(i).z = drones(i).homez : drones(i).lost = 0
      drones(i).hp = 3 : drones(i).state = 0 : drones(i).cooldown = 60 + i * 20
      drones(i).phase = i * 45 : drones(i).anim = -1 : drones(i).sight = 0
      drones(i).room = room_at(drones(i).x, drones(i).z)
      show object d : show object OBJ_HALO + i
      drone_anim(i, 0)
      position object d, drones(i).x, 0, drones(i).z
      position object OBJ_BLOB + i, drones(i).x, 0.3, drones(i).z
      loop sound 20 + i
   next i
   for i = 1 to MAX_BOLTS
      bolts(i).life = 0 : hide object OBJ_BOLT + i
   next i
   hide light 5 : hide light 6
   for i = 1 to pickupcount
      pickups(i).taken = 0 : show object OBJ_PICKUP + i
   next i
   show light 1 : show light 2 : show light 3
   loop sound 13
   starttime = timer()
   remaining = CORE_SECONDS
   attract# = 0 : lookx# = 0 : lookz# = 1
endfunction

function start_mode(newmode)
   mode = newmode
   modetimer = 0
   if mode = 1
      reset_game()
      show object OBJ_GUN
   endif
   if mode = 2 then play sound 16 : stop sound 8
   if mode = 3 then play sound 15 : stop sound 8
endfunction

rem ------------------------------------------------------------------
rem Player

rem ------------------------------------------------------------------
rem Attract tour: the camera glides through the facility under the title.

function attract_camera()
   if object visible(OBJ_GUN) = 1 then hide object OBJ_GUN
   inc modetimer
   attract# = attract# + 0.012
   if attract# >= pathcount then attract# = attract# - pathcount
   i = int(attract#) + 1 : t# = attract# - int(attract#)
   j = i + 1 : if j > pathcount then j = 1
   rem Smoothstep between tour points keeps the glide gentle.
   s# = t# * t# * (3 - 2 * t#)
   px# = path#(i, 1) + (path#(j, 1) - path#(i, 1)) * s#
   pz# = path#(i, 2) + (path#(j, 2) - path#(i, 2)) * s#
   roomhint = playerroom
   if room_at(px#, pz#) > 0 then playerroom = roomhint
   py# = EYE + 2 + sin(modetimer * 0.7) * 1.5
   lookx# = curvevalue(path#(j, 1), lookx#, 40)
   lookz# = curvevalue(path#(j, 2), lookz#, 40)
   yaw# = atanfull(lookx# - px#, lookz# - pz#)
   pitch# = sin(modetimer * 0.4) * 6
   position camera px#, py#, pz#
   rotate camera pitch#, yaw#, 0
   position listener px#, py#, pz#
   rotate listener 0, yaw#, 0
   if modetimer > 30 and (scancode() <> 0 or mouseclick() <> 0) then start_mode(1)
endfunction

