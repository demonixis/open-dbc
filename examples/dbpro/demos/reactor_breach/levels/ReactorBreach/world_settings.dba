REM OpenDBC world settings. Edited by the Studio Scene view.
FUNCTION SetupWorld_ReactorBreach()
   SET DISPLAY MODE 1280, 720, 32
   SYNC ON
   SYNC RATE 60
   HIDE MOUSE
   AUTOCAM OFF
   SET AMBIENT LIGHT 100
   COLOR AMBIENT LIGHT RGB(255, 255, 255)
   COLOR BACKDROP RGB(0, 0, 0)
   POSITION CAMERA 0, 20, -160
   ROTATE CAMERA 0, 0, 0
   SET CAMERA FOV 70
   SET CAMERA RANGE 1, 1200
ENDFUNCTION
