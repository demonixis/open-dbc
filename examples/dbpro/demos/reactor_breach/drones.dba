rem Reactor Breach - the security drones and their plasma bolts.
rem Included by reactor_breach.dba.

function drone_anim(i, clip)
   if drones(i).anim = clip then exitfunction
   drones(i).anim = clip
   d = OBJ_DRONE + i
   select clip
      case 0 : loop object d, 0, 40 : endcase
      case 1 : loop object d, 41, 71 : endcase
      case 2 : play object d, 72, 92 : endcase
      case 3 : play object d, 93, 103 : endcase
      case 4 : play object d, 104, 150 : endcase
   endselect
endfunction

function drones_update()
   for i = 1 to dronecount
      d = OBJ_DRONE + i
      dx# = px# - drones(i).x : dz# = pz# - drones(i).z
      dist# = sqrt(dx# * dx# + dz# * dz#)
      rem Patrolling drones in other rooms sleep: no animation, no thinking.
      awake = 0
      if drones(i).state = 1 then awake = 1
      if drones(i).state = 0 and (drones(i).room = playerroom or dist# < 120) then awake = 1
      if awake = 0 and drones(i).state = 0 and drones(i).anim <> 5 then stop object d : drones(i).anim = 5
      if awake = 1
         rem Line of sight is tested every 20 frames, staggered between drones.
         if (modetimer + i * 3) mod 20 = 0
            drones(i).sight = 0
            if dist# < 260
               set vector3 2, px# - drones(i).x, py# - 15.4, pz# - drones(i).z
               reach# = length vector3(2)
               normalize vector3 2, 2
               clear# = ray_level(drones(i).x, 15.4, drones(i).z, x vector3(2), y vector3(2), z vector3(2), reach#)
               if clear# >= reach# - 1 then clear# = ray_boxes(drones(i).x, 15.4, drones(i).z, x vector3(2), y vector3(2), z vector3(2), reach#, tallcount)
               if clear# >= reach# - 1 then drones(i).sight = 1
            endif
            if drones(i).sight = 1 then drones(i).lost = 0 else inc drones(i).lost
            if drones(i).sight = 1 and drones(i).state = 0 then drones(i).state = 1
            rem A hunter that loses sight for a while patrols where it stands.
            if drones(i).state = 1 and drones(i).lost > 8
               drones(i).state = 0 : drones(i).homex = drones(i).x : drones(i).homez = drones(i).z
            endif
         endif
         wantx# = 0 : wantz# = 0
         if drones(i).state = 0
            rem Patrol: a slow loop around the post.
            drones(i).phase = wrapvalue(drones(i).phase + 0.6)
            tx# = drones(i).homex + sin(drones(i).phase) * 14
            tz# = drones(i).homez + cos(drones(i).phase) * 14
            wantx# = (tx# - drones(i).x) * 0.05 : wantz# = (tz# - drones(i).z) * 0.05
            facing# = atanfull(wantx#, wantz#)
            drone_anim(i, 0)
         else
            rem Hunt: hold a firing distance and drift sideways to be harder to hit.
            facing# = atanfull(dx#, dz#)
            set vector3 1, dx#, 0, dz#
            normalize vector3 1, 1
            approach# = 0
            if dist# > 80 then approach# = 0.9
            if dist# < 45 then approach# = -0.7
            side# = sin(modetimer * 1.5 + i * 60) * 0.6
            wantx# = x vector3(1) * approach# + z vector3(1) * side#
            wantz# = z vector3(1) * approach# - x vector3(1) * side#
            if drones(i).anim < 2 or object playing(d) = 0 then drone_anim(i, 1)
            dec drones(i).cooldown
            if drones(i).cooldown <= 0 and drones(i).sight = 1
               drone_fire(i)
               drones(i).cooldown = 130 + rnd(80)
            endif
         endif
         move_drone(i, wantx#, wantz#)
         drones(i).yaw = curveangle(facing#, drones(i).yaw, 10)
         position object d, drones(i).x, 0, drones(i).z
         yrotate object d, drones(i).yaw
         position object OBJ_BLOB + i, drones(i).x, 0.3, drones(i).z
         position sound 20 + i, drones(i).x, 15, drones(i).z
      endif
   next i
endfunction

function move_drone(i, dx#, dz#)
   x# = drones(i).x : z# = drones(i).z
   nx# = x# + dx# : nz# = z# + dz#
   rem Drones hover over the crates; only tall obstacles stop them.
   roomhint = drones(i).room
   if get static collision hit(x# - 5, 14, z# - 5, x# + 5, 20, z# + 5, nx# - 5, 14, nz# - 5, nx# + 5, 20, nz# + 5) = 1
      nx# = nx# + get static collision x()
      nz# = nz# + get static collision z()
   endif
   rem Only the leading edge of the move can enter a wall.
   ex# = nx# + 6 : if dx# < 0 then ex# = nx# - 6
   if room_at(ex#, z# - 6) > 0 and room_at(ex#, z# + 6) > 0 then drones(i).x = nx#
   ez# = nz# + 6 : if dz# < 0 then ez# = nz# - 6
   if room_at(drones(i).x - 6, ez#) > 0 and room_at(drones(i).x + 6, ez#) > 0 then drones(i).z = nz#
   drones(i).room = roomhint
endfunction

function drone_fire(i)
   drone_anim(i, 2)
   b = 0
   for k = 1 to MAX_BOLTS
      if bolts(k).life = 0 then b = k : exit
   next k
   if b = 0 then exitfunction
   a# = drones(i).yaw
   bolts(b).x = drones(i).x + sin(a#) * 7 : bolts(b).y = 15.4 : bolts(b).z = drones(i).z + cos(a#) * 7
   set vector3 1, px# - bolts(b).x, py# - 1.5 - bolts(b).y, pz# - bolts(b).z
   normalize vector3 1, 1
   scale vector3 1, 1, 2.2
   bolts(b).vx = x vector3(1) : bolts(b).vy = y vector3(1) : bolts(b).vz = z vector3(1)
   bolts(b).life = 300
   rem Two lights ride the newest bolts in turn.
   bolts(b).light = nextlight
   for k = 1 to MAX_BOLTS
      if k <> b and bolts(k).light = nextlight then bolts(k).light = 0
   next k
   show light nextlight
   nextlight = 11 - nextlight
   show object OBJ_BOLT + b
   position sound 30, bolts(b).x, bolts(b).y, bolts(b).z : play sound 30
endfunction

function damage_drone(i)
   d = OBJ_DRONE + i
   play sound 4
   drones(i).state = 1
   dec drones(i).hp
   if drones(i).hp > 0
      drone_anim(i, 3)
      exitfunction
   endif
   rem Destroyed: the drone drops, its eye goes dark, a blast lights the room.
   drones(i).state = 3
   drone_anim(i, 4)
   hide object OBJ_HALO + i
   stop sound 20 + i
   inc kills
   x# = drones(i).x : z# = drones(i).z
   position particles 2, x#, 12, z# : boomframes = 6
   muzzle_light(x#, 14, z#, rgb(255, 140, 40))
   flashlight = 14
   position sound 31, x#, 12, z# : play sound 31
endfunction

function bolts_update()
   cx# = camera position x() : cy# = camera position y() : cz# = camera position z()
   for b = 1 to MAX_BOLTS
      if bolts(b).life > 0
         dec bolts(b).life
         ox# = bolts(b).x : oy# = bolts(b).y : oz# = bolts(b).z
         bolts(b).x = ox# + bolts(b).vx : bolts(b).y = oy# + bolts(b).vy : bolts(b).z = oz# + bolts(b).vz
         x# = bolts(b).x : y# = bolts(b).y : z# = bolts(b).z
         position object OBJ_BOLT + b, x#, y#, z#
         point object OBJ_BOLT + b, cx#, cy#, cz#
         if bolts(b).light > 0 then position light bolts(b).light, x#, y#, z#
         dead = 0
         if point_in_level(x#, z#) = 0 or y# < 0 or y# > 90 then dead = 1
         if get static collision hit(ox# - 1, oy# - 1, oz# - 1, ox# + 1, oy# + 1, oz# + 1, x# - 1, y# - 1, z# - 1, x# + 1, y# + 1, z# + 1) = 1 then dead = 1
         dx# = x# - px# : dy# = y# - (py# - 4) : dz# = z# - pz#
         if dx# * dx# + dy# * dy# * 0.3 + dz# * dz# < 40
            rem The attract tour is a ghost: bolts just burst on it.
            dead = 1
            if mode = 1 then health = health - 10 : hurt = 20 : play sound 6
         endif
         if dead = 1 or bolts(b).life = 0
            bolts(b).life = 0
            hide object OBJ_BOLT + b
            if bolts(b).light > 0 then hide light bolts(b).light : bolts(b).light = 0
            sparks(ox#, oy#, oz#)
         endif
      endif
   next b
endfunction
