circuit_data:
data 0.0, -225.0, 187.5, -240.0, 315.0, -165.0, 337.5, -15.0, 247.5, 90.0, 285.0, 210.0, 187.5, 300.0
data 30.0, 285.0, -90.0, 195.0, -112.5, 60.0, -240.0, 30.0, -315.0, -90.0, -247.5, -210.0, -112.5, -225.0

car_data:
data "YOU", 0.0, 1.0
data "TEAL", 1.5, 0.965
data "VIOLET", -1.5, 0.95
data "PEARL", 0.5, 0.94

rem Islets out at sea: angle, distance from the island centre, width and height scale
isle_data:
data -100, 560, 45, 20, -128, 640, 70, 30, -152, 600, 35, 16, -70, 620, 55, 24, -178, 600, 40, 18
