REM OpenDBC world settings. Edited by the Studio Scene view.
FUNCTION SetupWorld_DuskRally()
   SET DISPLAY MODE 1280, 720, 32
   SYNC ON
   SYNC RATE 60
   HIDE MOUSE
   AUTOCAM OFF
   POSITION CAMERA 0, 5, -240
   ROTATE CAMERA 0, 0, 0
   SET CAMERA FOV 68
   SET CAMERA RANGE 0.5, 950
ENDFUNCTION
