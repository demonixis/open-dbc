REM OpenDBC world settings. Edited by the Studio Scene view.
FUNCTION SetupWorld_Golden()
   SET DISPLAY MODE 640, 480, 32, 0
   SET WINDOW ON
   SET WINDOW TITLE "Scene golden"
   SYNC ON
   SYNC RATE 0
   AUTOCAM OFF
   SET AMBIENT LIGHT 40
   COLOR BACKDROP RGB(96, 128, 255)
   FOG ON
   FOG COLOR RGB(128, 128, 128)
   FOG DISTANCE 2500
   ROTATE LIGHT 0, 45, 30, 0
   COLOR LIGHT 0, RGB(255, 255, 255)
   SET SHADOW POSITION -1, 100, 300, 0
   POSITION CAMERA 0, 80, -200
   ROTATE CAMERA 15, 0, 0
   SET CAMERA FOV 60
   SET CAMERA RANGE 1, 10000
ENDFUNCTION
