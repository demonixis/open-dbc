REM OpenDBC level. Edited by the Studio Scene view.
REM @level objects=1000 images=1000 matrices=1 terrains=1 lights=1
FUNCTION LoadLevel_Golden()
   AUTOCAM OFF
   SET AMBIENT LIGHT 40
   COLOR BACKDROP RGB(96, 128, 255)
   FOG ON
   FOG COLOR RGB(128, 128, 128)
   FOG DISTANCE 2500
   ROTATE LIGHT 0, 45, 30, 0
   COLOR LIGHT 0, RGB(255, 255, 255)
   SET SHADOW POSITION -1, 100, 300, 0
   LOAD IMAGE "../fixtures/classic/bmp/stone.bmp", 1000
   LOAD IMAGE "../fixtures/classic/bmp/brick.bmp", 1001
   REM @object 1000 "Crate"
   MAKE OBJECT CUBE 1000, 12.5
   POSITION OBJECT 1000, 1, -2.5, 30
   ROTATE OBJECT 1000, 0, 45, 0
   SCALE OBJECT 1000, 150, 100, 100
   TEXTURE OBJECT 1000, 1000
   COLOR OBJECT 1000, RGB(255, 128, 0)
   SET OBJECT 1000, 0, 0, 1, 1, 1, 1, 1
   SET OBJECT DIFFUSE 1000, RGB(192, 192, 192)
   SET OBJECT SPECULAR 1000, RGB(255, 255, 255)
   SET OBJECT SPECULAR POWER 1000, 32
   SET SHADOW SHADING ON 1000
   REM @object 1001 "Ball"
   MAKE OBJECT SPHERE 1001, 20, 24, 32
   TEXTURE OBJECT 1001, 1000
   GHOST OBJECT ON 1001
   REM @object 1002 "Wall"
   MAKE OBJECT PLAIN 1002, 50, 25
   ROTATE OBJECT 1002, 0, 90, 0
   REM @object 1003 "Dome"
   LOAD OBJECT "../fixtures/classic/models/dome.x", 1003
   POSITION OBJECT 1003, 0, 0, 100
   REM @object 1004 "Walker"
   LOAD OBJECT "../fixtures/classic/models/walk.x", 1004
   POSITION OBJECT 1004, 20, 0, 50
   SET OBJECT SPEED 1004, 40
   LOOP OBJECT 1004, 0, 20
   REM @matrix 1 "Ground"
   MAKE MATRIX 1, 1000, 800, 20, 16
   PREPARE MATRIX TEXTURE 1, 1001, 2, 2
   FILL MATRIX 1, 5, 3
   SET MATRIX HEIGHT 1, 0, 0, 0
   SET MATRIX HEIGHT 1, 1, 1, 12.5
   UPDATE MATRIX 1
   POSITION MATRIX 1, -500, 0, -400
   REM @light 1 "Lamp"
   MAKE LIGHT 1
   SET SPOT LIGHT 1, 20, 40
   POSITION LIGHT 1, 0, 100, 0
   ROTATE LIGHT 1, 90, 0, 0
   SET LIGHT RANGE 1, 500
   COLOR LIGHT 1, RGB(255, 255, 192)
   REM @terrain 1 "Hills"
   MAKE TERRAIN 1, "../fixtures/classic/bmp/stone.bmp"
   TEXTURE TERRAIN 1, 1001
   POSITION TERRAIN 1, 0, -10, 0
   POSITION CAMERA 0, 80, -200
   ROTATE CAMERA 15, 0, 0
   SET CAMERA FOV 60
   SET CAMERA RANGE 1, 10000
ENDFUNCTION
