rem Runs the Studio Scene view's generated files as a Classic program includes them
#include "scene/classic/levels/Golden/world_settings.dba"
SetupWorld_Golden()
#include "scene/classic/levels/Golden/Golden.dba"
LoadLevel_Golden()

print "objects="; object exist(1000); object exist(1001); object exist(1002); object exist(1003)
print "crate="; int(object position x(1000)); ","; int(object position z(1000)); ","; int(object angle y(1000))
print "wall="; int(object angle y(1002))
print "dome="; int(object position z(1003))
print "matrix="; matrix exist(1); ","; int(matrix position x(1)); ","; int(matrix position z(1))
print "light="; light exist(1); ","; light type(1); ","; int(light range(1))
print "camera="; int(camera position y()); ","; int(camera position z()); ","; int(camera angle x())
print "walker="; object looping(1004); ","; object playing(1004); ","; int(object speed(1004))
print "rock="; object exist(1005); ","; static line of sight(-40, 5, 0, -40, 5, 100, 1, 1)
print "sound="; sound exist(1); ","; sound type(1); ","; int(sound position x(1)); ","; sound looping(1)
print "TEST_DONE"
sync
end
