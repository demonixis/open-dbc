rem DBPro portable file, directory, memblock and host compatibility
sync on : sync rate 0

make memblock 1, 12
write memblock byte 1, 0, 10
write memblock word 1, 1, 513
write memblock dword 1, 3, 100000
write memblock byte 1, 7, 20
write memblock float 1, 8, 3.5
make memblock 2, 12
copy memblock 1, 2, 0, 0, 12
print "COPY_BYTE="; memblock byte(2, 7)
print "COPY_WORD="; memblock word(2, 1)
print "COPY_FLOAT="; memblock float(2, 8)
print "MB_EXISTS="; memblock exist(2)

open to write 1, "_lot15_raw.bin"
make file from memblock 1, 2
close file 1
print "RAW_SIZE="; file size("_lot15_raw.bin")
print "RAW_BYTE="; read byte from file("_lot15_raw.bin", 7)
write byte to file "_lot15_raw.bin", 7, 42

open to read 2, "_lot15_raw.bin"
print "OPEN="; file open(2)
print "END_BEFORE="; file end(2)
make memblock from file 3, 2
print "FILE_MB_SIZE="; get memblock size(3)
print "FILE_MB_BYTE="; memblock byte(3, 7)
print "EOF_READ="; read byte(2)
print "END_AFTER="; file end(2)
close file 2
print "CLOSED="; file open(2)

open to write 3, "_lot15_sized.bin"
write memblock 3, 1
close file 3
open to read 3, "_lot15_sized.bin"
read memblock 3, 4
close file 3
print "SIZED_SIZE="; get memblock size(4)
print "SIZED_DWORD="; memblock dword(4, 3)

open to write 4, "_lot15_skip.bin"
write byte 4, 1
write byte 4, 2
write byte 4, 3
write byte 4, 4
close file 4
open to read 4, "_lot15_skip.bin"
skip bytes 4, 2
print "SKIPPED_BYTE="; read byte(4)
close file 4

open to write 5, "_lot15_values.bin"
write byte 5, 255
write word 5, 513
write long 5, 123456
write float 5, 3.5
write file 5, -77
write string 5, "first"
write string 5, "second"
close file 5
open to read 5, "_lot15_values.bin"
print "FUNC_BYTE="; read byte(5)
print "FUNC_WORD="; read word(5)
print "FUNC_LONG="; read long(5)
print "FUNC_FLOAT="; read float(5)
read file 5, function_file
read string 5, first$
read string 5, second$
close file 5
print "FUNC_FILE="; function_file
print "READ_STRING="; first$
print "READ_FILE="; second$
open to read 5, "_lot15_values.bin"
read byte 5, command_byte
read word 5, command_word
read long 5, command_long
read float 5, command_float#
read file 5, command_file
close file 5
print "COMMAND_BYTE="; command_byte
print "COMMAND_WORD="; command_word
print "COMMAND_LONG="; command_long
print "COMMAND_FLOAT="; command_float#
print "COMMAND_FILE="; command_file

open to write 6, "_lot43_block_source.bin"
write byte 6, 7
write file 6, -123
close file 6
open to write 6, "_lot43_pack.bin"
write fileblock 6, "_lot43_block_source.bin"
close file 6
delete file "_lot43_block_source.bin"
open to read 6, "_lot43_pack.bin"
read fileblock 6, "_lot43_block_copy.bin"
close file 6
open to read 6, "_lot43_block_copy.bin"
print "BLOCK_BYTE="; read byte(6)
read file 6, block_long
close file 6
print "BLOCK_LONG="; block_long

make directory "_lot15_dir"
make file "_lot15_dir/alpha.bin"
print "PATH_EXISTS="; path exist("_lot15_dir")
print "FILE_EXISTS="; file exist("_lot15_dir/alpha.bin")
set dir "_lot15_dir"
print "DIR_NONEMPTY="; len(get dir$()) > 0
find first
print "FIND_NAME="; get file name$()
print "FIND_TYPE="; get file type()
print "FIND_DATE="; len(get file date$()) > 0
find next
print "FIND_END_TYPE="; get file type()
perform checklist for files
print "CHECK_COUNT="; checklist quantity()
print "CHECK_NAME="; checklist string$(1)
print "CHECK_TYPE="; checklist value a(1)
print "CHECK_SIZE="; checklist value b(1)
print "CHECK_C="; checklist value c(1)
print "CHECK_D="; checklist value d(1)
empty checklist
print "CHECK_EMPTY="; checklist quantity()
set dir ".."
rename file "_lot15_dir/alpha.bin", "_lot15_dir/beta.bin"
move file "_lot15_dir/beta.bin", "_lot15_moved.bin"
delete file "_lot15_moved.bin"
delete directory "_lot15_dir"

print "CL_EMPTY="; len(cl$())
print "DATE_LENGTH="; len(get date$())
print "TIME_LENGTH="; len(get time$())
print "APPNAME_NONEMPTY="; len(appname$()) > 0
print "MYDOC_NONEMPTY="; len(mydocdir$()) > 0

delete file "_lot15_raw.bin"
delete file "_lot15_sized.bin"
delete file "_lot15_skip.bin"
delete file "_lot15_values.bin"
delete file "_lot43_pack.bin"
delete file "_lot43_block_copy.bin"
delete memblock 1
delete memblock 2
delete memblock 3
delete memblock 4
print "TEST_DONE"
sync
end
