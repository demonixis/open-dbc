rem Grammar DarkBASIC Classic has no spelling for. The parser only opens these
rem in DBPro mode; tests/unit/test_frontend.cpp checks the Classic side stays shut.
sync on : sync rate 0

rem Bare declaration, no DIM / LOCAL / GLOBAL in front.
n as integer
n = 7
print "DECL="; n

rem Radix literals: binary, octal, hex — all eleven.
print "RADIX="; %1011; ","; 0c13; ","; 0x0B

rem Bitwise operators.
a = 5 : b = 3
print "SHR="; a >> 1
print "SHL="; a << 2
print "AND="; a && b
print "OR="; a || b
print "XOR="; a ~~ b

rem Shifts bind tighter than the bitwise operators, which bind tighter than
rem the comparisons: 1 << 3 = 8, 8 && 12 = 8, and 8 = 8 is true.
print "PRECEDENCE="; 1 << 3 && 12 = 8

rem A whole TYPE on one line, then an array of it.
type point x y endtype
dim spot(4) as point
spot(2).x = 30
spot(2).y = 40
print "FIELDS="; spot(2).x; ","; spot(2).y

rem UDT assignment and function arguments have value semantics.
dim original as point
dim copied as point
original.x = 7
copied = original
copied.x = 99
print "COPY="; original.x; ","; copied.x
print "PARAM="; mutatepoint(original); ","; original.x

rem INC and DEC reaching an array element.
dim tally(4)
tally(1) = 10
inc tally(1)
print "INC="; tally(1)
inc tally(1), 5
print "INCSTEP="; tally(1)
dec tally(1), 6
print "DEC="; tally(1)

sync
end

function mutatepoint(p as point)
p.x = 123
endfunction p.x
