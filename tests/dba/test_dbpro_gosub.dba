rem GOSUB in the DBPro profile: a subroutine shares the main program's variables, may call
rem another one and a function, returns from inside a loop, and takes a label declared later.
sync on : sync rate 0

total = 0
depth = 0
gosub _add_three
print "TOTAL="; total

for round = 1 to 3
    gosub _accumulate
next round
print "ROUNDS="; total

gosub _outer
print "NESTED="; depth

gosub _early
print "EARLY="; found

value = 4
gosub _through_function
print "FUNCTION="; value

print "TEST_DONE"
sync
end

_add_three:
    total = total + 3
return

_accumulate:
    total = total + round
return

_outer:
    depth = depth + 1
    gosub _inner
    depth = depth + 10
return

_inner:
    depth = depth + 100
return

_early:
    found = 0
    for i = 1 to 10
        if i = 4
            found = i
            return
        endif
    next i
    found = -1
return

_through_function:
    value = Double(value)
return

function Double(number)
endfunction number * 2
