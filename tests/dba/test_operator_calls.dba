rem A variable followed by AND/OR and then a call or an array read is an expression, not a multi-word name
sync on : sync rate 0

dim flags(5)
flags(2) = 1
a = 2 : b = 2 : c = 3
if a = b and flags(2) = 1 then print "and-array ok"
if a = c or flags(2) = 1 then print "or-array ok"
if a = b and half(10) = 5 then print "and-function ok"
if a<>c and flags(a)=1 then print "compact ok"
if a = b and not flags(1) then print "and-not ok"
x = a and flags(2)
print "x="; x
print "TEST_DONE"
sync
end

function half(v)
r = v / 2
endfunction r
