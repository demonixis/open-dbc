rem Test the DBPro MATRIX4 family (dba_matrix4.hpp)
rem Row-major with row vectors, like DirectX: translation lives in the 4th row.
sync on : sync rate 0

make matrix4 1
make matrix4 2
make matrix4 3
print "MAKE_FUNCTION="; make matrix4(4)
print "MAKE_FUNCTION_BAD="; make matrix4(0)

print "MAKE_VECTOR2_FUNCTION="; make vector2(201)
set vector2 201, 7, 8
print "REMAKE_VECTOR2_FUNCTION="; make vector2(201)
print "RESET_VECTOR2="; x vector2(201); ","; y vector2(201)
print "DELETE_VECTOR2_FUNCTION="; delete vector2(201)
print "DELETE_VECTOR2_MISSING="; delete vector2(201)
print "DELETE_VECTOR2_BAD="; delete vector2(0)

print "MAKE_VECTOR3_FUNCTION="; make vector3(202)
set vector3 202, 7, 8, 9
print "REMAKE_VECTOR3_FUNCTION="; make vector3(202)
print "RESET_VECTOR3="; x vector3(202); ","; y vector3(202); ","; z vector3(202)
print "DELETE_VECTOR3_FUNCTION="; delete vector3(202)
print "DELETE_VECTOR3_MISSING="; delete vector3(202)
print "DELETE_VECTOR3_BAD="; delete vector3(0)

print "MAKE_VECTOR4_FUNCTION="; make vector4(203)
set vector4 203, 7, 8, 9, 10
print "REMAKE_VECTOR4_FUNCTION="; make vector4(203)
print "RESET_VECTOR4="; x vector4(203); ","; y vector4(203); ","; z vector4(203); ","; w vector4(203)
print "DELETE_VECTOR4_FUNCTION="; delete vector4(203)
print "DELETE_VECTOR4_MISSING="; delete vector4(203)
print "DELETE_VECTOR4_BAD="; delete vector4(0)

print "MAKE_MATRIX4_FUNCTION="; make matrix4(204)
set identity matrix4 204
print "REMAKE_MATRIX4_FUNCTION="; make matrix4(204)
print "RESET_MATRIX4="; get matrix4 element(204, 0)
print "DELETE_MATRIX4_FUNCTION="; delete matrix4(204)
print "DELETE_MATRIX4_MISSING="; delete matrix4(204)
print "DELETE_MATRIX4_BAD="; delete matrix4(0)

print "SHARED_MAKE_VECTOR2="; make vector2(205)
print "SHARED_MAKE_MATRIX4="; make matrix4(205)
print "SHARED_DELETE_VECTOR2="; delete vector2(205)
print "SHARED_DELETE_MATRIX4="; delete matrix4(205)
make matrix4 5
make matrix4 6
make matrix4 7
make matrix4 8
make matrix4 9
make matrix4 10
make matrix4 11
make matrix4 12
make matrix4 13
make matrix4 14
make matrix4 15
make matrix4 16
make matrix4 17
make matrix4 18
make matrix4 19
make matrix4 20
scale matrix4 4, 2, 3, 4
print "INVERSE_DETERMINANT="; inverse matrix4(5, 4)

print "NEW_IS_IDENTITY="; is identity matrix4(1)

rem Translation goes to elements 12,13,14
translate matrix4 2, 10, 20, 30
print "TX="; get matrix4 element(2, 12)
print "TY="; get matrix4 element(2, 13)
print "TZ="; get matrix4 element(2, 14)
print "TRANSLATED_IS_IDENTITY="; is identity matrix4(2)

rem Scale then translate must keep both parts
scale matrix4 3, 2, 4, 8
multiply matrix4 1, 3, 2
print "CONCAT_SX="; get matrix4 element(1, 0)
print "CONCAT_SY="; get matrix4 element(1, 5)
print "CONCAT_TX="; get matrix4 element(1, 12)

rem A matrix times its inverse is the identity
inverse matrix4 3, 2
multiply matrix4 1, 2, 3
print "INVERSE_ROUNDTRIP="; is identity matrix4(1)

rem Transpose moves element 12 to element 3
transpose matrix4 1, 2
print "TRANSPOSED="; get matrix4 element(1, 3)

rem D3DX matrix commands take radians, as the original DBPro examples do.
halfpi# = 1.57079632679
rotate y matrix4 3, halfpi#
print "COS90_IS_ZERO="; abs(get matrix4 element(3, 0)) < 0.0001
print "SIN90="; get matrix4 element(3, 2)

set identity matrix4 6
scale matrix4 7, 2, 3, 4
add matrix4 8, 6, 7
print "ADD_DIAGONAL="; get matrix4 element(8, 0); ","; get matrix4 element(8, 5); ","; get matrix4 element(8, 10); ","; get matrix4 element(8, 15)
subtract matrix4 9, 8, 7
print "SUBTRACT_IDENTITY="; is identity matrix4(9)
divide matrix4 7, 2
print "DIVIDE_DIAGONAL="; get matrix4 element(7, 0); ","; get matrix4 element(7, 5); ","; get matrix4 element(7, 10); ","; get matrix4 element(7, 15)

rotate x matrix4 10, halfpi#
rotate z matrix4 11, halfpi#
rotate ypr matrix4 12, 0, 0, halfpi#
print "ROTATE_X="; abs(get matrix4 element(10, 5)) < 0.0001; ","; get matrix4 element(10, 6)
print "ROTATE_Z="; abs(get matrix4 element(11, 0)) < 0.0001; ","; get matrix4 element(11, 1)
print "ROTATE_YPR="; is equal matrix4(11, 12)

make vector3 111
set vector3 111, 0, 1, 0
build rotation axis matrix4 13, 111, halfpi#
print "ROTATE_AXIS="; abs(get matrix4 element(13, 0)) < 0.0001; ","; get matrix4 element(13, 2)

build fov lhmatrix4 14, halfpi#, 2, 1, 101
build fov rhmatrix4 15, halfpi#, 2, 1, 101
print "FOV_LH="; abs(get matrix4 element(14, 0) - 0.5) < 0.0001; ","; abs(get matrix4 element(14, 5) - 1.0) < 0.0001; ","; get matrix4 element(14, 11)
print "FOV_RH="; abs(get matrix4 element(15, 10) + 1.01) < 0.0001; ","; get matrix4 element(15, 11)

build perspective lhmatrix4 14, 4, 2, 1, 101
build perspective rhmatrix4 15, 4, 2, 1, 101
print "PERSPECTIVE_LH="; get matrix4 element(14, 0); ","; get matrix4 element(14, 5); ","; get matrix4 element(14, 11)
print "PERSPECTIVE_RH="; get matrix4 element(15, 0); ","; get matrix4 element(15, 5); ","; get matrix4 element(15, 11); ","; abs(get matrix4 element(15, 14) + 1.01) < 0.0001

build ortho lhmatrix4 14, 4, 2, 1, 101
build ortho rhmatrix4 15, 4, 2, 1, 101
print "ORTHO_LH="; get matrix4 element(14, 0); ","; get matrix4 element(14, 5); ","; abs(get matrix4 element(14, 10) - 0.01) < 0.0001
print "ORTHO_RH="; get matrix4 element(15, 0); ","; get matrix4 element(15, 5); ","; abs(get matrix4 element(15, 10) + 0.01) < 0.0001

make vector3 112
make vector3 113
make vector3 114
set vector3 112, 0, 0, 0
set vector3 113, 0, 0, 1
set vector3 114, 0, 1, 0
build lookat lhmatrix4 16, 112, 113, 114
print "LOOKAT_LH="; is identity matrix4(16)
set vector3 113, 0, 0, -1
build lookat rhmatrix4 16, 112, 113, 114
print "LOOKAT_RH="; is identity matrix4(16)

build reflection matrix4 16, 0, 2, 0, 0
print "REFLECTION_NORMALIZES="; get matrix4 element(16, 5)

translate matrix4 17, 10, 20, 30
make vector2 101
make vector2 102
set vector2 101, 1, 2
transform coords vector2 102, 101, 17
print "TRANSFORM_VECTOR2="; x vector2(102); ","; y vector2(102)

make vector4 121
make vector4 122
set vector4 121, 1, 2, 3, 1
transform vector4 122, 121, 17
print "TRANSFORM_VECTOR4="; x vector4(122); ","; y vector4(122); ","; z vector4(122); ","; w vector4(122)

set identity matrix4 18
set identity matrix4 19
set identity matrix4 20
make vector3 115
make vector3 116
set vector3 115, 0, 0, 0
project vector3 116, 115, 18, 19, 20
print "PROJECT_VECTOR3="; x vector3(116); ","; y vector3(116); ","; z vector3(116)

set identity matrix4 2
print "RESET_IS_IDENTITY="; is identity matrix4(2)

copy matrix4 1, 2
print "COPY_EQUAL="; is equal matrix4(1, 2)

rem Device matrices reflect the exact camera state used for rendering.
position camera 10, 20, 30
rotate camera 0, 0, 0
view matrix4 1
print "VIEW_TRANSLATION="; get matrix4 element(1, 12); ","; get matrix4 element(1, 13); ","; get matrix4 element(1, 14)
world matrix4 2
print "WORLD_IDENTITY="; is identity matrix4(2)

set camera aspect 2.0
set camera fov 90.0
set camera range 1.0, 101.0
projection matrix4 3
print "PROJECTION_ASPECT="; abs(get matrix4 element(3, 0) - 0.5) < 0.0001
print "PROJECTION_FOV="; abs(get matrix4 element(3, 5) - 1.0) < 0.0001
print "PROJECTION_DEPTH="; abs(get matrix4 element(3, 10) - 1.01) < 0.0001

delete matrix4 1
delete matrix4 2
delete matrix4 3
delete matrix4 4
delete matrix4 5
delete matrix4 6
delete matrix4 7
delete matrix4 8
delete matrix4 9
delete matrix4 10
delete matrix4 11
delete matrix4 12
delete matrix4 13
delete matrix4 14
delete matrix4 15
delete matrix4 16
delete matrix4 17
delete matrix4 18
delete matrix4 19
delete matrix4 20
delete vector2 101
delete vector2 102
delete vector3 111
delete vector3 112
delete vector3 113
delete vector3 114
delete vector3 115
delete vector3 116
delete vector4 121
delete vector4 122

print "TEST_DONE"
sync
end
