print acos(0) = 90
print asin(1) > 89.99 and asin(1) < 90.01
print atan(1) = 45
print atanfull(1, 0) = 90
print curveangle(180, 0, 10) = 18
print curvevalue(100, 0, 10) = 10
print exp(0) = 1
print hcos(0) = 1
print hsin(0) = 0
print htan(0) = 0
