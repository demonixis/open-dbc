print newyvalue(10, 90, 2) = 12
print newzvalue(10, 0, 2) = 12
print sqrt(9) = 3
print tan(0) = 0
print ceil(1.2) = 2
print floor(-1.2) = -2
print bin$(5) = "101"
print chr$(65) = "A"
print hex$(255) = "FF"
print instr("abc", "b") = 2
print left$("abcd", 2) = "ab"
print lower$("AbC") = "abc"
print right$("abcd", 2) = "cd"
print val("12.5") = 12.5
