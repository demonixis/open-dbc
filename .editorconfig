root = true

# C++ layout lives in .clang-format; this covers the editors that do not read it.
[*]
insert_final_newline = true

[{*.{cpp,hpp,h,c,mm,hlsl,fx,py,cmake},CMakeLists.txt}]
indent_style = space
indent_size = 4

[*.json]
indent_style = space
indent_size = 2

# BASIC sources keep their own encoding and line endings (Windows-1252, CRLF): no charset or
# end_of_line here.
